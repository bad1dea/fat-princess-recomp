+/* Free an image once every set that may still read it has finished, without draining the GPU. */
+static void vk_retire_image(vk_image* im)
+{
+    if (!im->img && !im->view && !im->mem) { memset(im, 0, sizeof *im); return; }
+    if (!vk_async_enabled()) { vk_destroy_image(im); return; }
+    unsigned pending=0;
+    for(unsigned i=0;i<VK_ASYNC_SETS;i++)if(s_set_inflight[i])pending|=1u<<i;
+    if(s_batch_recording)pending|=1u<<s_cur_set;
+    if(!pending){vk_destroy_image_now(im);return;}
+    if (s_retired_img_count == s_retired_img_cap) {
+        const unsigned cap = s_retired_img_cap ? s_retired_img_cap * 2 : 32;
+        vk_retired_image* grown = (vk_retired_image*)realloc(s_retired_img, cap * sizeof *grown);
+        if (!grown) { vk_destroy_image(im); return; }
+        s_retired_img = grown; s_retired_img_cap = cap;
+    }
+    s_retired_img[s_retired_img_count++] = (vk_retired_image){*im,pending};
+    memset(im, 0, sizeof *im);
+}
