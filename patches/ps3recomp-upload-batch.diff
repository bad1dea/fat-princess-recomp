+/* Texture creation and uploads used to drain every in-flight set and submit on their own, so each new texture cost a
+ * GPU round trip (10-50 ms hitches while scenes streamed in). They now record into the open batch like a clear does and
+ * the staging memory is retired with the set. RSX_UPLOAD_BATCH=0 restores the old behaviour. */
+static unsigned long long s_batch_stage_bytes;
+static int vk_upload_batch_begin(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) { const char* e = getenv("RSX_UPLOAD_BATCH"); enabled = !e || strcmp(e, "0"); }
+    if (!enabled || s_batch_draw || !vk_async_enabled() || !vk_batch_enabled()) return 0;
+    vk_batch_end_pass();
+    s_batch_draw = 1;
+    return 1;
+}
