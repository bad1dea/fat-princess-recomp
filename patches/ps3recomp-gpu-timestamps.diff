+/* True GPU time per set: a timestamp as the set's command buffer starts and one as it ends (FP_GPU_TS=0 turns it off). The
+ * submit-to-fence figure above also counts the time the host took to notice the fence, so it cannot tell a slow GPU from a
+ * slow host thread; these can. */
+static VkQueryPool s_ts_pool;
+static double s_ts_ms;            /* milliseconds per timestamp tick */
+static int s_ts_state[VK_ASYNC_SETS];   /* 0 none, 1 start written, 2 both written */
+static double s_ts_sum, s_ts_max;
+static unsigned s_ts_n, s_ts_over25, s_ts_over100;
+static void vk_ts_init(void)
+{
+    const char* e = getenv("FP_GPU_TS");
+    if (e && e[0] == '0') return;
+    u32 n = 0;
+    pvkGetPhysicalDeviceQueueFamilyProperties(s_vk.phys, &n, NULL);
+    if (n == 0 || n > 64 || s_vk.queue_family >= n) return;
+    VkQueueFamilyProperties props[64];
+    pvkGetPhysicalDeviceQueueFamilyProperties(s_vk.phys, &n, props);
+    if (props[s_vk.queue_family].timestampValidBits == 0) { VK_LOG("gpu timestamps: not supported by the queue\n"); return; }
+    VkPhysicalDeviceProperties dp;
+    pvkGetPhysicalDeviceProperties(s_vk.phys, &dp);
+    VkQueryPoolCreateInfo qi = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+                                 .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = 2 * VK_ASYNC_SETS };
+    if (pvkCreateQueryPool(s_vk.device, &qi, NULL, &s_ts_pool) != VK_SUCCESS) { s_ts_pool = VK_NULL_HANDLE; return; }
+    s_ts_ms = (double)dp.limits.timestampPeriod / 1.0e6;
+    VK_LOG("gpu timestamps on (period %.3f ns)\n", (double)dp.limits.timestampPeriod);
+}
+static void vk_ts_begin(unsigned set)
+{
+    if (!s_ts_pool) return;
+    pvkCmdResetQueryPool(s_vk.cmd, s_ts_pool, set * 2, 2);
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s_ts_pool, set * 2);
+    s_ts_state[set] = 1;
+}
+static void vk_ts_end(unsigned set)
+{
+    if (!s_ts_pool || s_ts_state[set] != 1) return;
+    pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s_ts_pool, set * 2 + 1);
+    s_ts_state[set] = 2;
+}
+static void vk_ts_collect(unsigned set)
+{
+    if (!s_ts_pool || s_ts_state[set] != 2) return;
+    s_ts_state[set] = 0;
+    uint64_t t[2];
+    if (pvkGetQueryPoolResults(s_vk.device, s_ts_pool, set * 2, 2, sizeof t, t, sizeof t[0],
+                               VK_QUERY_RESULT_64_BIT) != VK_SUCCESS || t[1] < t[0]) return;
+    const double ms = (double)(t[1] - t[0]) * s_ts_ms;
+    s_ts_sum += ms; s_ts_n++;
+    if (ms > s_ts_max) s_ts_max = ms;
+    if (ms > 25.0) s_ts_over25++;
+    if (ms > 100.0) s_ts_over100++;
+}
