diff --git a/libs/video/rsx_live_output.inc b/libs/video/rsx_live_output.inc
new file mode 100644
index 00000000..ff2dab41
--- /dev/null
+++ b/libs/video/rsx_live_output.inc
@@ -0,0 +1,166 @@
+/* Output resizing never changes guest surface addresses or their geometry. */
+static int ld_output_pipeline(void)
+{
+    if (g.output_pso) return 0;
+    static const char shader[] =
+        "Texture2D image:register(t0); SamplerState linearClamp:register(s0);"
+        "struct V { float4 pos:SV_Position; float2 uv:TEXCOORD0; };"
+        "V vs(uint id:SV_VertexID) { V v; float2 p=float2((id<<1)&2,id&2);"
+        "v.pos=float4(p.x*2-1,1-p.y*2,0,1); v.uv=p; return v; }"
+        "float4 ps(V v):SV_Target { return image.SampleLevel(linearClamp,v.uv,0); }";
+    ID3DBlob *vs = NULL, *ps = NULL, *sig = NULL, *errors = NULL;
+    HRESULT hr = D3DCompile(shader, sizeof shader - 1, "host output", NULL, NULL,
+        "vs", "vs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &errors);
+    if (FAILED(hr)) goto fail;
+    if (errors) { errors->lpVtbl->Release(errors); errors = NULL; }
+    hr = D3DCompile(shader, sizeof shader - 1, "host output", NULL, NULL,
+        "ps", "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &errors);
+    if (FAILED(hr)) goto fail;
+    if (errors) { errors->lpVtbl->Release(errors); errors = NULL; }
+    D3D12_DESCRIPTOR_RANGE range = {0};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    range.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER param = {0};
+    param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    param.DescriptorTable.NumDescriptorRanges = 1;
+    param.DescriptorTable.pDescriptorRanges = &range;
+    param.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC sampler = {0};
+    sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    sampler.MaxLOD = D3D12_FLOAT32_MAX;
+    sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC root = {0};
+    root.NumParameters = 1; root.pParameters = &param;
+    root.NumStaticSamplers = 1; root.pStaticSamplers = &sampler;
+    hr = D3D12SerializeRootSignature(&root, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &errors);
+    if (FAILED(hr)) goto fail;
+    hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0,
+        sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+        &IID_ID3D12RootSignature, (void**)&g.output_root);
+    if (FAILED(hr)) goto fail;
+    D3D12_DESCRIPTOR_HEAP_DESC heap = {0};
+    heap.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heap.NumDescriptors = 1; heap.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    hr = g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &heap, &IID_ID3D12DescriptorHeap, (void**)&g.output_srv);
+    if (FAILED(hr)) goto fail;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = g.output_root;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+    pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+    pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    pd.DepthStencilState.StencilReadMask = pd.DepthStencilState.StencilWriteMask = 0xff;
+    pd.DepthStencilState.FrontFace.StencilFailOp = D3D12_STENCIL_OP_KEEP;
+    pd.DepthStencilState.FrontFace.StencilDepthFailOp = D3D12_STENCIL_OP_KEEP;
+    pd.DepthStencilState.FrontFace.StencilPassOp = D3D12_STENCIL_OP_KEEP;
+    pd.DepthStencilState.FrontFace.StencilFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    pd.DepthStencilState.BackFace = pd.DepthStencilState.FrontFace;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.SampleDesc.Count = 1;
+    hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd,
+        &IID_ID3D12PipelineState, (void**)&g.output_pso);
+fail:
+    if (errors) errors->lpVtbl->Release(errors);
+    if (sig) sig->lpVtbl->Release(sig);
+    if (vs) vs->lpVtbl->Release(vs);
+    if (ps) ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[d3d-fail] host output pipeline hr=0x%08lX\n", (unsigned long)hr);
+        if (g.output_srv) g.output_srv->lpVtbl->Release(g.output_srv);
+        if (g.output_root) g.output_root->lpVtbl->Release(g.output_root);
+        g.output_srv = NULL; g.output_root = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+int rsx_live_draw_set_output_size(u32 width, u32 height)
+{
+    if (!g.ready || !width || !height || width > 8192 || height > 8192) return -1;
+    if (width == g.output_width && height == g.output_height) return 0;
+    if (ld_output_pipeline()) return -1;
+    ld_flush(LD_FLUSH_PRESENT);
+    if (!g.ready) return -1;
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; ++i) {
+        g.backbuf[i]->lpVtbl->Release(g.backbuf[i]);
+        g.backbuf[i] = NULL;
+    }
+    const HRESULT hr = g.swap->lpVtbl->ResizeBuffers(g.swap, LD_SWAP_BUFFERS,
+        width, height, DXGI_FORMAT_R8G8B8A8_UNORM, 0);
+    /* A failed ResizeBuffers retains the previous swapchain. Reacquire it too. */
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; ++i) {
+        const HRESULT buffer_hr = g.swap->lpVtbl->GetBuffer(g.swap, i,
+            &IID_ID3D12Resource, (void**)&g.backbuf[i]);
+        if (FAILED(buffer_hr)) { g.ready = 0; return -1; }
+        g.dev->lpVtbl->CreateRenderTargetView(g.dev, g.backbuf[i], NULL, rtv_handle(i));
+    }
+    if (FAILED(hr)) {
+        fprintf(stderr, "[d3d-fail] ResizeBuffers %ux%u hr=0x%08lX; retained %ux%u\n",
+            width, height, (unsigned long)hr, g.output_width, g.output_height);
+        return -1;
+    }
+    g.output_width = width; g.output_height = height;
+    fprintf(stderr, "[D3D12-live] live output %ux%u (guest buffers unchanged)\n", width, height);
+    return 0;
+}
+
+/* Source starts/ends as RENDER_TARGET; backbuffer starts as PRESENT and ends
+ * as COPY_DEST, so the host panel can be copied afterwards. */
+static int ld_output_copy(ID3D12Resource* src, ID3D12Resource* bb, u32 bbi, u32 width, u32 height)
+{
+    const int scaled = width != g.output_width || height != g.output_height;
+    if (scaled && ld_output_pipeline()) return -1;
+    D3D12_RESOURCE_BARRIER bars[2] = {0};
+    for (int i = 0; i < 2; ++i) {
+        bars[i].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        bars[i].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    bars[0].Transition.pResource = src;
+    bars[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    bars[0].Transition.StateAfter = scaled ? D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE : D3D12_RESOURCE_STATE_COPY_SOURCE;
+    bars[1].Transition.pResource = bb;
+    bars[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    bars[1].Transition.StateAfter = scaled ? D3D12_RESOURCE_STATE_RENDER_TARGET : D3D12_RESOURCE_STATE_COPY_DEST;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, bars);
+    if (scaled) {
+        D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+        D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+        g.output_srv->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.output_srv, &cpu);
+        g.output_srv->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.output_srv, &gpu);
+        D3D12_SHADER_RESOURCE_VIEW_DESC srv = {0};
+        srv.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv.Texture2D.MipLevels = 1;
+        g.dev->lpVtbl->CreateShaderResourceView(g.dev, src, &srv, cpu);
+        ID3D12DescriptorHeap* heaps[] = {g.output_srv};
+        g.list->lpVtbl->SetDescriptorHeaps(g.list, 1, heaps);
+        g.list->lpVtbl->SetGraphicsRootSignature(g.list, g.output_root);
+        g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 0, gpu);
+        g.list->lpVtbl->SetPipelineState(g.list, g.output_pso);
+        D3D12_VIEWPORT viewport = {0, 0, (float)g.output_width, (float)g.output_height, 0, 1};
+        D3D12_RECT scissor = {0, 0, (LONG)g.output_width, (LONG)g.output_height};
+        const D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_handle(bbi);
+        g.list->lpVtbl->RSSetViewports(g.list, 1, &viewport);
+        g.list->lpVtbl->RSSetScissorRects(g.list, 1, &scissor);
+        g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &rtv, FALSE, NULL);
+        g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+        bars[1].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        bars[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    } else g.list->lpVtbl->CopyResource(g.list, bb, src);
+    bars[0].Transition.StateBefore = bars[0].Transition.StateAfter;
+    bars[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, scaled ? 2 : 1, bars);
+    return 0;
+}
