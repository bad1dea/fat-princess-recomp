diff --git a/libs/audio/tests/test_audio_ring.c b/libs/audio/tests/test_audio_ring.c
index b6252c94..bee65316 100644
--- a/libs/audio/tests/test_audio_ring.c
+++ b/libs/audio/tests/test_audio_ring.c
@@ -5,6 +5,7 @@
  */
 #include "../cellAudio.c"
 #include <assert.h>
+#include <math.h>
 
 uint8_t* vm_base;
 uint32_t ppu_vm_size;
@@ -70,6 +71,43 @@ int main(void)
     assert(vm_read64(0x308) == 1000000 + 35 * 256000000ULL / 48000);
     assert(cellAudioGetPortTimestamp(0, 36, (void*)0x308) == CELL_AUDIO_ERROR_TAG_NOT_FOUND);
     assert(cellAudioGetPortBlockTag(0, 32, (void*)0x300) == CELL_AUDIO_ERROR_PARAM);
+    /* A mix that goes past full scale comes out lowered, not flattened: a 1.9 amplitude sine, many blocks. */
+    {
+        AudioPortSlot* port = &s_ports[1];
+        memset(port, 0, sizeof(*port));
+        port->in_use = port->running = 1;
+        port->param.nChannel = 8;
+        port->param.nBlock = 8;
+        port->param.level = 1.0f;
+        port->read_idx_addr = 64;
+        port->buffer = calloc(8 * CELL_AUDIO_BLOCK_SAMPLES * 8, sizeof(float));
+        assert(port->buffer);
+        s_ports[0].running = 0;
+        unsigned long flat = 0, total = 0;
+        float peak = 0.0f, quiet_peak = 0.0f;
+        for (unsigned b = 0; b < 400; ++b) {
+            float* blk = port->buffer + (port->read_index % 8) * CELL_AUDIO_BLOCK_SAMPLES * 8;
+            for (unsigned i = 0; i < CELL_AUDIO_BLOCK_SAMPLES; ++i) {
+                const float v = (b < 200 ? 1.9f : 0.2f) * sinf(6.2831853f * 440.0f * (float)(b * CELL_AUDIO_BLOCK_SAMPLES + i) / 48000.0f);
+                uint32_t bits; memcpy(&bits, &v, 4); bits = __builtin_bswap32(bits);
+                memcpy(&blk[i * 8], &bits, 4);
+                memcpy(&blk[i * 8 + 1], &bits, 4);
+            }
+            audio_mix_one_block();
+            for (unsigned i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; ++i) {
+                const float a = fabsf(s_mix_buffer[i]);
+                if (a > peak) peak = a;
+                if (b >= 20 && b < 200) { total++; if (a >= 0.999f) flat++; }
+                if (b >= 380 && a > quiet_peak) quiet_peak = a;
+            }
+        }
+        free(port->buffer);
+        memset(port, 0, sizeof(*port));
+        assert(peak <= 1.0f);
+        assert(flat * 100 < total);                     /* under 1% of the loud samples sit on the ceiling */
+        assert(quiet_peak > 0.17f);                     /* the level came back up after the loud part */
+        printf("audio limiter: loud part %lu of %lu samples at the ceiling, quiet part peak %.3f\n", flat, total, quiet_peak);
+    }
     munmap(vm_base, 0x100000000ULL);
     puts("audio ring: 3 sizes, 3 wraps each passed");
     return 0;
diff --git a/libs/font/cellL10n.c b/libs/font/cellL10n.c
index d1b4b1e5..7116af8e 100644
--- a/libs/font/cellL10n.c
+++ b/libs/font/cellL10n.c
@@ -10,6 +10,7 @@
 #include "cellL10n.h"
 #include <stdio.h>
 #include <string.h>
+#include "../../runtime/ppu/ppu_memory.h"   /* vm_read*: guest EA -> host, byte-swapped */
 
 /* ---------------------------------------------------------------------------
  * Internal UTF helpers
@@ -551,3 +552,111 @@ s32 l10n_convert_str(s32 src_code, const void* src, u32* src_len,
                           (u32)dst_code, dst, out_len, dst_len);
     return rc;
 }
+
+
+/* ---------------------------------------------------------------------------
+ * Guest entry points. The functions above take host pointers and host-order
+ * UTF-16; the title passes guest addresses, keeps its lengths in big-endian
+ * guest words and expects big-endian UTF-16. Marked for tools/gen_hle_nids.py,
+ * since the export names carry no cell/sce prefix. Fat Princess converts the
+ * local player's name with UTF8stoUTF16s; unregistered, the call answered OK
+ * and left the output empty, so the lobby row for the local player was blank.
+ * -----------------------------------------------------------------------*/
+
+#define L10N_GUEST_MAX 4096
+
+static u32 guest_read_utf8(u32 ea, u32 len, u8* out, int stop_at_nul)
+{
+    u32 n = 0;
+    while (n < len && n < L10N_GUEST_MAX) {
+        u8 c = vm_read8(ea + n);
+        if (stop_at_nul && c == 0) break;
+        out[n++] = c;
+    }
+    return n;
+}
+
+static u32 guest_read_utf16(u32 ea, u32 len, u16* out, int stop_at_nul)
+{
+    u32 n = 0;
+    while (n < len && n < L10N_GUEST_MAX) {
+        u16 c = vm_read16(ea + 2 * n);
+        if (stop_at_nul && c == 0) break;
+        out[n++] = c;
+    }
+    return n;
+}
+
+static s32 guest_utf8_to_utf16(u32 src, u32 src_len, u32 dst, u32 dst_len_ea, int nul_terminated, u32 src_len_ea)
+{
+    static u8 in[L10N_GUEST_MAX];
+    static u16 out[L10N_GUEST_MAX];
+    if (!src || !dst || !dst_len_ea) return (s32)CELL_L10N_ERROR_INVALID_PARAM;
+    u32 n = guest_read_utf8(src, src_len, in, nul_terminated);
+    u32 room = vm_read32(dst_len_ea);
+    if (room > L10N_GUEST_MAX) room = L10N_GUEST_MAX;
+    u32 produced = room;
+    s32 rc = UTF8toUTF16(in, n, out, &produced);
+    if (rc != CELL_OK) return rc;
+    for (u32 i = 0; i < produced; i++) vm_write16(dst + 2 * i, out[i]);
+    if (nul_terminated && produced < room) vm_write16(dst + 2 * produced, 0);
+    if (src_len_ea) vm_write32(src_len_ea, n);
+    vm_write32(dst_len_ea, produced);
+    return CELL_OK;
+}
+
+static s32 guest_utf16_to_utf8(u32 src, u32 src_len, u32 dst, u32 dst_len_ea, int nul_terminated, u32 src_len_ea)
+{
+    static u16 in[L10N_GUEST_MAX];
+    static u8 out[L10N_GUEST_MAX * 4];
+    if (!src || !dst || !dst_len_ea) return (s32)CELL_L10N_ERROR_INVALID_PARAM;
+    u32 n = guest_read_utf16(src, src_len, in, nul_terminated);
+    u32 room = vm_read32(dst_len_ea);
+    if (room > sizeof out) room = sizeof out;
+    u32 produced = room;
+    s32 rc = UTF16toUTF8(in, n, out, &produced);
+    if (rc != CELL_OK) return rc;
+    for (u32 i = 0; i < produced; i++) vm_write8(dst + i, out[i]);
+    if (nul_terminated && produced < room) vm_write8(dst + produced, 0);
+    if (src_len_ea) vm_write32(src_len_ea, n);
+    vm_write32(dst_len_ea, produced);
+    return CELL_OK;
+}
+
+/* HLE_NID: UTF8stoUTF16s */
+s32 fp_l10n_UTF8stoUTF16s(u32 utf8, u32 utf8_len_ea, u32 utf16, u32 utf16_len_ea)
+{
+    if (!utf8_len_ea) return (s32)CELL_L10N_ERROR_INVALID_PARAM;
+    return guest_utf8_to_utf16(utf8, vm_read32(utf8_len_ea), utf16, utf16_len_ea, 1, utf8_len_ea);
+}
+
+/* HLE_NID: UTF16stoUTF8s */
+s32 fp_l10n_UTF16stoUTF8s(u32 utf16, u32 utf16_len_ea, u32 utf8, u32 utf8_len_ea)
+{
+    if (!utf16_len_ea) return (s32)CELL_L10N_ERROR_INVALID_PARAM;
+    return guest_utf16_to_utf8(utf16, vm_read32(utf16_len_ea), utf8, utf8_len_ea, 1, utf16_len_ea);
+}
+
+/* HLE_NID: UTF8toUTF16 */
+s32 fp_l10n_UTF8toUTF16(u32 utf8, u32 utf8_len, u32 utf16, u32 utf16_len_ea)
+{
+    return guest_utf8_to_utf16(utf8, utf8_len, utf16, utf16_len_ea, 0, 0);
+}
+
+/* HLE_NID: UTF16toUTF8 */
+s32 fp_l10n_UTF16toUTF8(u32 utf16, u32 utf16_len, u32 utf8, u32 utf8_len_ea)
+{
+    return guest_utf16_to_utf8(utf16, utf16_len, utf8, utf8_len_ea, 0, 0);
+}
+
+/* HLE_NID: UTF8toUCS2 */
+s32 fp_l10n_UTF8toUCS2(u32 utf8, u32 utf8_len, u32 ucs2, u32 ucs2_len_ea)
+{
+    return guest_utf8_to_utf16(utf8, utf8_len, ucs2, ucs2_len_ea, 0, 0);
+}
+
+/* HLE_NID: UCS2toUTF8 */
+s32 fp_l10n_UCS2toUTF8(u32 ucs2, u32 ucs2_len, u32 utf8, u32 utf8_len_ea)
+{
+    return guest_utf16_to_utf8(ucs2, ucs2_len, utf8, utf8_len_ea, 0, 0);
+}
