+/* REGISTER (type PSNR_REGISTER, arg is the email), LOGIN (PSNR_LOGIN, arg unused). Fills token and the name as the
+ * server has it. 0 on success, a PSNR_E_* code on a refusal, -1 when the server cannot be reached. */
+int np_account_request(uint8_t type, const char* name, const char* password, const char* arg,
+                       char* token_out, size_t token_size, char* name_out)
+{
+    char host[256];
+    uint16_t port;
+    uint8_t body[16 + 2 + 64 + 2 + 120];
+    if (!server_addr(host, &port)) return -1;
+    size_t pl = strlen(password), al = arg ? strlen(arg) : 0;
+    if (pl > 64) pl = 64;
+    if (al > 120) al = 120;
+    memset(body, 0, 16);
+    strncpy((char*)body, name, 16);
+    uint8_t* p = psnr_put16(body + 16, (uint16_t)pl);
+    memcpy(p, password, pl);
+    p += pl;
+    uint32_t len = (uint32_t)(p - body);
+    if (type == PSNR_REGISTER) {
+        p = psnr_put16(p, (uint16_t)al);
+        memcpy(p, arg ? arg : "", al);
+        len = (uint32_t)(p + al - body);
+    }
+    psnr_msg r;
+    int rc = psnr_account_call(host, port, type, body, len, &r, 5000);
+    if (rc != 1) return -1;
+    int ret = -1;
+    if (r.type == PSNR_ERROR && r.len >= 4) ret = (int)psnr_get32(r.data);
+    else if (r.type == PSNR_ACCOUNT_OK && r.len >= 2) {
+        uint32_t tl = psnr_get16(r.data);
+        if (2 + tl <= r.len && tl < token_size) {
+            memcpy(token_out, r.data + 2, tl);
+            token_out[tl] = 0;
+            if (name_out) {
+                if (type == PSNR_LOGIN && r.len >= 2 + tl + 16) { memcpy(name_out, r.data + 2 + tl, 16); name_out[16] = 0; }
+                else { strncpy(name_out, name, 16); name_out[16] = 0; }
+            }
+            ret = 0;
+        }
+    }
+    psnr_msg_free(&r);
+    return ret;
