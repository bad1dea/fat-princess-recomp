diff --git a/libs/video/tests/test_live_draw_output.c b/libs/video/tests/test_live_draw_output.c
new file mode 100644
index 00000000..ad0158c7
--- /dev/null
+++ b/libs/video/tests/test_live_draw_output.c
@@ -0,0 +1,91 @@
+/* Exercise real swapchain replacements and read back the presented pixels.
+ * Include the implementation to inspect the actual scanout buffers; no GPU API is mocked. */
+#include "../rsx_live_draw.c"
+#include "live_draw_test_harness.h"
+#include <assert.h>
+
+static void check_output(u32 index, u32 width, u32 height)
+{
+    ID3D12Resource* bb = g.backbuf[index];
+    D3D12_RESOURCE_DESC desc;
+    bb->lpVtbl->GetDesc(bb, &desc);
+    assert(desc.Width == width && desc.Height == height);
+    const u32 pitch = (width * 4 + 255) & ~255u;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = (UINT64)pitch * height;
+    bd.Height = bd.DepthOrArraySize = bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    assert(SUCCEEDED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp,
+        D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+        &IID_ID3D12Resource, (void**)&rb)));
+    D3D12_RESOURCE_BARRIER bar = {0};
+    bar.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    bar.Transition.pResource = bb;
+    bar.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    bar.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    bar.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &bar);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = bb; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    dst.PlacedFootprint.Footprint.Width = width;
+    dst.PlacedFootprint.Footprint.Height = height;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+    bar.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    bar.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &bar);
+    ld_flush(LD_FLUSH_READBACK);
+    assert(g.ready);
+    void* pixels = NULL;
+    D3D12_RANGE range = {0, (SIZE_T)pitch * height};
+    assert(SUCCEEDED(rb->lpVtbl->Map(rb, 0, &range, &pixels)));
+    /* The guest drew a white left half on a black background. Both halves
+     * must reach the corresponding output quarters after scaling in either direction. */
+    for (u32 y = height / 4; y <= height * 3 / 4; y += height / 4) {
+        const u8* left = (const u8*)pixels + (size_t)y * pitch + width / 4 * 4;
+        const u8* right = (const u8*)pixels + (size_t)y * pitch + width * 3 / 4 * 4;
+        assert(left[0] > 240 && left[1] > 240 && left[2] > 240);
+        assert(right[0] < 8 && right[1] < 8 && right[2] < 8);
+    }
+    rb->lpVtbl->Unmap(rb, 0, NULL);
+    rb->lpVtbl->Release(rb);
+}
+
+int main(void)
+{
+    if (ldh_init("live output resize") != 0) return 2;
+    rsx_test_fp_mov_r0_col0(ldh_main + 0x1000, RSX_TEST_FP_SWZ_IDENT);
+    ldh_setup_quad(0, 1, 1, 0, 0);
+    rsx_live_draw_set_display_buffer(0, 0, 0x10000, 256, 64, 64);
+    const u32 sizes[][2] = {{64,64}, {1280,720}, {1920,1080}, {1280,720}, {32,32}, {64,64}};
+    for (u32 i = 0; i < sizeof sizes / sizeof sizes[0]; ++i) {
+        rsx_null_backend_set_fullscreen(i%2);
+        BOOL exclusive = TRUE;
+        assert(SUCCEEDED(g.swap->lpVtbl->GetFullscreenState(g.swap,&exclusive,NULL)) && !exclusive);
+        assert(rsx_live_draw_set_output_size(sizes[i][0],sizes[i][1]) == 0);
+        assert(rsx_live_draw_set_output_size(sizes[i][0],sizes[i][1]) == 0);
+        for (int frame = 0; frame < 3; ++frame) {
+            ldh_surface(0x108, 0x10000, 256, 0x200000, 256, 64, 64);
+            ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFF000000u);
+            ldh_m(NV4097_CLEAR_SURFACE, 0xF0u);
+            ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, 32u << 16);
+            ldh_draw(0x1000, 0x40, 0, 0, 0x207);
+            const u32 index = g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap);
+            rsx_live_draw_present(0);
+            assert(g.ready);
+            check_output(index, sizes[i][0], sizes[i][1]);
+        }
+    }
+    assert(rsx_live_draw_set_output_size(0,720) == -1);
+    assert(rsx_live_draw_set_output_size(9000,720) == -1);
+    rsx_live_draw_shutdown();
+    rsx_null_backend_shutdown();
+    puts("D3D12 output: 18 frames, real 720p/1080p resize cycles, repeated requests, scaled pixels verified");
+    return 0;
+}
diff --git a/libs/video/tests/test_null_backend_window_win.c b/libs/video/tests/test_null_backend_window_win.c
new file mode 100644
index 00000000..bfed93b0
--- /dev/null
+++ b/libs/video/tests/test_null_backend_window_win.c
@@ -0,0 +1,53 @@
+/* Run under a private Xvfb when using Wine. Exercises the production Win32
+ * window that the live D3D12 renderer uses, including its menu Escape key. */
+#include "../rsx_null_backend.c"
+#include <assert.h>
+
+void rsx_set_backend(rsx_backend* backend) { (void)backend; }
+u32 rsx_live_draw_get_last_draws(void) { return 0; }
+double rsx_live_draw_get_present_fps(void) { return 0; }
+
+int main(void)
+{
+    assert(rsx_null_backend_init(640, 480, "isolated window regression") == 0);
+    HWND window = rsx_null_backend_get_hwnd();
+    assert(IsWindow(window));
+    rsx_null_backend_suppress_present(1);
+    RECT original, full, restored;
+    GetWindowRect(window, &original);
+    const LONG_PTR style = GetWindowLongPtr(window, GWL_STYLE);
+    for (int cycle = 0; cycle < 4; ++cycle) {
+        rsx_null_backend_set_fullscreen(1);
+        rsx_null_backend_set_fullscreen(1);
+        assert(s_state.fullscreen && !(GetWindowLongPtr(window, GWL_STYLE) & WS_OVERLAPPEDWINDOW));
+        MONITORINFO monitor = {0}; monitor.cbSize = sizeof(monitor);
+        assert(GetMonitorInfo(MonitorFromWindow(window, MONITOR_DEFAULTTONEAREST), &monitor));
+        GetWindowRect(window, &full); assert(EqualRect(&full, &monitor.rcMonitor));
+        SendMessageA(window, WM_SYSKEYDOWN, VK_RETURN, (LPARAM)1 << 29);
+        SendMessageA(window, WM_SYSKEYDOWN, VK_RETURN, ((LPARAM)1 << 29) | ((LPARAM)1 << 30));
+        assert(s_state.fullscreen && IsWindow(window));
+        rsx_null_backend_set_fullscreen(0);
+        rsx_null_backend_set_fullscreen(0);
+        GetWindowRect(window, &restored);
+        assert(EqualRect(&restored, &original) && GetWindowLongPtr(window, GWL_STYLE) == style);
+    }
+    for (int cycle = 0; cycle < 3; ++cycle) {
+        assert(rsx_null_backend_set_output_size(1280, 720)==0);
+        GetClientRect(window,&restored);assert(restored.right==1280 && restored.bottom==720);
+        rsx_null_backend_set_fullscreen(1);
+        GetWindowRect(window,&full);
+        // Leave room for window borders on the test monitor. GPU tests cover 1080p scanout.
+        assert(rsx_null_backend_set_output_size(960,540)==0);
+        GetWindowRect(window,&restored);assert(EqualRect(&full,&restored));
+        rsx_null_backend_set_fullscreen(0);
+        GetClientRect(window,&restored);assert(restored.right==960 && restored.bottom==540);
+    }
+    SendMessageA(window, WM_KEYDOWN, VK_ESCAPE, 0);
+    assert(IsWindow(window) && !s_state.window_closed);
+    assert(rsx_null_backend_pump_messages() == 0);
+    rsx_null_backend_suppress_present(0);
+    SendMessageA(window, WM_KEYDOWN, VK_ESCAPE, 0);
+    assert(!IsWindow(window) && s_state.window_closed);
+    puts("live window: fullscreen cycles restore geometry/style; Alt+Enter is consumed; Escape belongs to host menu");
+    return 0;
+}
