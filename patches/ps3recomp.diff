+/* Host trophy list: the first registered context's trophies. Returns the count (0 when none is registered yet) and
+ * fills up to `max` entries. Strings stay valid until the context is destroyed. */
+int sceNpTrophyHostList(sceNpTrophyHostEntry* out, int max, const char** title)
+{
+    for (int c = 1; c <= SCE_NP_TROPHY_MAX_CONTEXTS; c++) {
+        TrophyContext* ctx = &s_contexts[c];
+        if (!s_trophy_initialized || !ctx->in_use || !ctx->registered) continue;
+        if (title) *title = ctx->title ? ctx->title : "";
+        const int n = (int)ctx->total_trophies;
+        for (int i = 0; i < n && i < max && out; i++) {
+            out[i].id = i;
+            out[i].name = ctx->name[i] ? ctx->name[i] : "";
+            out[i].detail = ctx->detail[i] ? ctx->detail[i] : "";
+            out[i].grade = ctx->grade[i] ? ctx->grade[i] : SCE_NP_TROPHY_GRADE_BRONZE;
+            out[i].hidden = ctx->hidden[i];
+            out[i].unlocked = ctx->unlocked[i];
+            out[i].timestamp = ctx->unlock_time[i];
+        }
+        return n;
+    }
+    return 0;
+}
+
+/* The trophy's TROPnnn.PNG (malloc'd, the caller frees) or NULL. */
+unsigned char* sceNpTrophyHostIcon(int trophyId, unsigned* size)
+{
+    for (int c = 1; c <= SCE_NP_TROPHY_MAX_CONTEXTS; c++) {
+        TrophyContext* ctx = &s_contexts[c];
+        if (!s_trophy_initialized || !ctx->in_use || !ctx->registered) continue;
+        char icon_name[24];
+        u32 sz = 0;
+        snprintf(icon_name, sizeof icon_name, "TROP%03d.PNG", trophyId);
+        u8* p = trp_read(&ctx->commId, icon_name, &sz);
+        if (size) *size = p ? sz : 0;
+        return p;
+    }
+    return NULL;
+}
+
+/* Host preview: the name of trophyId in the first registered context, or NULL. */
+const char* sceNpTrophyPreviewName(int trophyId)
+{
+    for (int c = 1; c <= SCE_NP_TROPHY_MAX_CONTEXTS; c++) {
+        TrophyContext* ctx = &s_contexts[c];
+        if (s_trophy_initialized && ctx->in_use && ctx->registered && trophyId >= 0 &&
+            (u32)trophyId < ctx->total_trophies)
+            return ctx->name[trophyId];
+    }
+    return NULL;
+}
+
+/* Host preview: run the unlock hook for trophyId of the first registered context without unlocking it.
+ * Returns 0 when it ran, -1 while no context is registered yet or the id is out of range. */
+int sceNpTrophyPreviewUnlock(int trophyId)
+{
+    for (int c = 1; c <= SCE_NP_TROPHY_MAX_CONTEXTS; c++) {
+        TrophyContext* ctx = &s_contexts[c];
+        if (!s_trophy_initialized || !ctx->in_use || !ctx->registered) continue;
+        if (trophyId < 0 || (u32)trophyId >= ctx->total_trophies || !s_unlock_hook) return -1;
+        char icon_name[24];
+        u32 icon_size = 0;
+        snprintf(icon_name, sizeof icon_name, "TROP%03d.PNG", trophyId);
+        u8* icon = trp_read(&ctx->commId, icon_name, &icon_size);
+        s_unlock_hook(trophyId, ctx->name[trophyId] ? ctx->name[trophyId] : "", ctx->grade[trophyId], icon,
+                      icon ? icon_size : 0);
+        free(icon);
+        return 0;
+    }
+    return -1;
+}
