+/* Hash of every guest vertex byte the group reads over elements [first, last]; 0 when a span is not mapped.
+ * Interleaved attributes read overlapping spans of one buffer, so the spans are merged per location and each byte is
+ * hashed once. */
+static u64 vc_source(const rsx_vertex_layout_plan* layout, u32 first, u32 last)
+{
+    const rsx_vertex_fetch_plan* plan = &dc.fetch_plan;
+    struct { u64 start, end; u32 loc; } span[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 n = 0;
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const rsx_vertex_fetch_attr* a = &plan->attr[layout->attrs[slot]];
+        if (!a->desc.type || !a->desc.size) continue;
+        const u64 start = (u64)plan->base_offset + a->desc.offset + (u64)first * a->stride;
+        const u64 end = start + (u64)(last - first) * a->stride + a->elem_size;
+        if (end > 0x100000000ull) return 0;
+        span[n].start = start; span[n].end = end; span[n].loc = a->desc.location; n++;
+    }
+    for (u32 i = 1; i < n; i++)   /* insertion sort by (location, start) */
+        for (u32 j = i; j > 0 && (span[j].loc < span[j-1].loc ||
+                                  (span[j].loc == span[j-1].loc && span[j].start < span[j-1].start)); j--) {
+            const __typeof__(span[0]) t = span[j]; span[j] = span[j-1]; span[j-1] = t;
+        }
+    XXH3_state_t st;
+    XXH3_64bits_reset(&st);
+    XXH3_64bits_update(&st, &first, sizeof first);
+    XXH3_64bits_update(&st, &last, sizeof last);
+    for (u32 i = 0; i < n; ) {
+        u64 start = span[i].start, end = span[i].end;
+        const u32 loc = span[i].loc;
+        u32 j = i + 1;
+        for (; j < n && span[j].loc == loc && span[j].start <= end; j++)
+            if (span[j].end > end) end = span[j].end;
+        const u8* p = eng_guest_ptr(NULL, loc, (u32)start, (u32)(end - start));
+        if (!p) return 0;
+        XXH3_64bits_update(&st, &start, sizeof start);
+        XXH3_64bits_update(&st, p, (size_t)(end - start));
+        i = j;
+    }
+    const u64 h = XXH3_64bits_digest(&st);
+    return h ? h : 1;
