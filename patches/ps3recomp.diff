+static int server_addr(char host[256], uint16_t* port)
+{
+    const char* e = getenv("PSNR_SERVER");
+    if (!e || !*e) return 0;
+    snprintf(host, 256, "%s", e);
+    *port = 36100;
+    char* colon = strrchr(host, ':');
+    if (colon) { *colon = 0; *port = (uint16_t)atoi(colon + 1); }
