+/* The host's notification card (a trophy unlock) is copied onto the window image top right, after any host panel.
+ * Copies are opaque, so the rounded corners come from copying each corner row narrower: rsx_notify_inset gives how
+ * many pixels to leave out at both ends of a row of an h-row card with corner radius r. */
+#pragma once
+#include <math.h>
+#include <stdint.h>
+
+static inline uint32_t rsx_notify_inset(uint32_t row, uint32_t h, uint32_t r)
+{
+    if (r * 2 > h) r = h / 2;
+    const uint32_t d = row < r ? r - row : row + r >= h ? row + r + 1 - h : 0;   /* rows from the straight edge */
+    if (!d) return 0;
+    const float y = (float)d - 0.5f;
+    return (uint32_t)((float)r - sqrtf((float)(r * r) - y * y) + 0.5f);
+}
+
+/* Card position: right edge and top edge both padded by a fortieth of the window height (18 px at 720p). */
+static inline void rsx_notify_origin(uint32_t win_w, uint32_t win_h, uint32_t w, uint32_t h, int32_t* x, int32_t* y)
+{
+    const uint32_t pad = win_h / 40 > 8 ? win_h / 40 : 8;
+    *x = win_w > w + pad ? (int32_t)(win_w - w - pad) : 0;
+    *y = win_h > h + pad ? (int32_t)pad : 0;
+}
