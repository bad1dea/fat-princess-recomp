+static u32 savedata_file_type(const char* save_path, const char* name)
+{
+    u32 t = savedata_content_type(name);
+    return t == CELL_SAVEDATA_FILETYPE_NORMALFILE && pfd_has(save_path, name)
+         ? CELL_SAVEDATA_FILETYPE_SECUREFILE : t;
+}
