+
+static Conn* conn_by_name(const char* name)
+{
+    for (int i = 0; i < SCE_NP_SIGNALING_CONN_MAX; i++)
+        if (s_conn[i].in_use && !strcmp(s_conn[i].name, name)) return &s_conn[i];
+    return NULL;
+}
+
+static Conn* conn_new(const char* name)
+{
+    for (int i = 0; i < SCE_NP_SIGNALING_CONN_MAX; i++)
+        if (!s_conn[i].in_use) {
+            memset(&s_conn[i], 0, sizeof(Conn));
+            s_conn[i].in_use = 1;
+            s_conn[i].id = s_next_conn++;
+            snprintf(s_conn[i].name, sizeof(s_conn[i].name), "%s", name);
+            return &s_conn[i];
+        }
+    return NULL;
+}
