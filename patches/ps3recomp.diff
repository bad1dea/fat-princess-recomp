diff --git a/libs/video/vulkan/rsx_vk_interp_me4.comp b/libs/video/vulkan/rsx_vk_interp_me4.comp
new file mode 100644
index 00000000..6db532f7
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_interp_me4.comp
@@ -0,0 +1,40 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+// Coarse symmetric motion search: one workgroup per 8x8 block of 1/4-size luma. The block at P in the middle
+// frame is predicted by prev(P - d) and cur(P + d), d in [-8, 8]^2. Both luma tiles are staged in shared memory.
+layout(local_size_x = 64) in;
+#include "rsx_vk_interp_common.glsl"
+const int R = 8;
+const int N = 2 * R + 1;
+const int T = 8 + 2 * R;
+shared float tp[T * T];
+shared float tc[T * T];
+shared uint best;
+void main()
+{
+    ivec2 blocks = (imageSize(uL4Cur) + 7) / 8;
+    ivec2 b = ivec2(gl_WorkGroupID.xy);
+    if (b.x >= blocks.x || b.y >= blocks.y) return;
+    if (gl_LocalInvocationIndex == 0) best = 0xFFFFFFFFu;
+    ivec2 org = b * 8;
+    for (int i = int(gl_LocalInvocationIndex); i < T * T; i += 64) {
+        ivec2 q = org - R + ivec2(i % T, i / T);
+        tp[i] = LUMA_AT(uL4Prev, q);
+        tc[i] = LUMA_AT(uL4Cur, q);
+    }
+    barrier();
+    for (int c = int(gl_LocalInvocationIndex); c < N * N; c += 64) {
+        ivec2 d = ivec2(c % N - R, c / N - R);
+        float sad = 0.0;
+        for (int y = 0; y < 8; y++)
+            for (int x = 0; x < 8; x++)
+                sad += abs(tp[(y + R - d.y) * T + (x + R - d.x)] - tc[(y + R + d.y) * T + (x + R + d.x)]);
+        float cost = sad + 0.02 * float(abs(d.x) + abs(d.y));
+        atomicMin(best, (uint(cost * 1024.0) << 9) | uint(c));
+    }
+    barrier();
+    if (gl_LocalInvocationIndex == 0) {
+        int c = int(best & 511u);
+        coarse[b.y * blocks.x + b.x] = ivec2(c % N - R, c / N - R);
+    }
+}
