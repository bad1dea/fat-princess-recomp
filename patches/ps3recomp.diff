+/* The trophy set ships as TROPDIR/<commId>_00/TROPHY.TRP in the game directory: a big-endian header
+ * (magic 0xDCA24D00, entry count at +0x10, entry size at +0x14, entries from +0x40: 32-byte name, u64 offset,
+ * u64 size) followed by the files. TROP.SFM is the XML trophy list with id, ttype, name and detail; TROPnnn.PNG
+ * is each trophy's icon. Returns a malloc'd copy of the member (NUL-terminated) or NULL. */
+static u8* trp_read(const SceNpCommunicationId* commId, const char* member, u32* size_out)
+{
+    const char* hdd0 = getenv("PS3_HDD0_ROOT");
+    const char* boot = getenv("PS3_BOOT_PATH");          /* /dev_hdd0/game/<TITLE>/USRDIR/... */
+    const char* g = boot ? strstr(boot, "/game/") : NULL;
+    if (!hdd0 || !g) return NULL;
+    g += 6;
+    int title_len = (int)strcspn(g, "/");
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/game/%.*s/TROPDIR/%s_00/TROPHY.TRP", hdd0, title_len, g, commId->data);
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    u8 h[0x40];
+    u8* out = NULL;
+    if (fread(h, 1, sizeof h, f) == sizeof h &&
+        h[0] == 0xDC && h[1] == 0xA2 && h[2] == 0x4D && h[3] == 0x00) {
+        u32 count = ((u32)h[0x10] << 24) | ((u32)h[0x11] << 16) | ((u32)h[0x12] << 8) | h[0x13];
+        u32 esz = ((u32)h[0x14] << 24) | ((u32)h[0x15] << 16) | ((u32)h[0x16] << 8) | h[0x17];
+        u8 e[0x40];
+        for (u32 i = 0; i < count && i < 256 && esz >= 0x30 && esz <= sizeof e && !out; i++) {
+            if (fseek(f, 0x40 + (long)(i * esz), SEEK_SET) != 0 || fread(e, 1, esz, f) != esz) break;
+            if (strncmp((const char*)e, member, 32) != 0) continue;
+            u64 off = 0, size = 0;
+            for (int b = 0; b < 8; b++) { off = (off << 8) | e[32 + b]; size = (size << 8) | e[40 + b]; }
+            if (size == 0 || size > (4u << 20) || fseek(f, (long)off, SEEK_SET) != 0) break;
+            out = (u8*)malloc((size_t)size + 1);
+            if (out && fread(out, 1, (size_t)size, f) == size) { out[size] = 0; if (size_out) *size_out = (u32)size; }
+            else { free(out); out = NULL; }
+        }
+    }
+    fclose(f);
+    return out;
+}
+
+/* Copy the text between <tag> and </tag> after p, decoding the five XML entities. */
+static char* sfm_text(const char* p, const char* end, const char* tag)
+{
+    char open[32], close[32];
+    snprintf(open, sizeof open, "<%s>", tag);
+    snprintf(close, sizeof close, "</%s>", tag);
+    const char* a = strstr(p, open);
+    if (!a || a >= end) return NULL;
+    a += strlen(open);
+    const char* b = strstr(a, close);
+    if (!b || b > end) return NULL;
+    char* s = (char*)malloc((size_t)(b - a) + 1);
+    if (!s) return NULL;
+    size_t n = 0;
+    static const struct { const char* e; char c; } ent[] = {
+        {"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'}, {"&quot;", '"'}, {"&apos;", '\''}};
+    while (a < b) {
+        size_t k = 0;
+        for (; k < sizeof ent / sizeof ent[0]; k++)
+            if (!strncmp(a, ent[k].e, strlen(ent[k].e))) break;
+        if (k < sizeof ent / sizeof ent[0]) { s[n++] = ent[k].c; a += strlen(ent[k].e); }
+        else s[n++] = *a++;
+    }
+    s[n] = 0;
+    return s;
+}
+
+static void trophy_load_set(TrophyContext* ctx)
+{
+    char* sfm = (char*)trp_read(&ctx->commId, "TROP.SFM", NULL);
+    if (!sfm) { printf("[sceNpTrophy] no TROP.SFM for %s\n", ctx->commId.data); return; }
+    u32 count = 0;
+    for (const char* p = strstr(sfm, "<trophy "); p; ) {
+        const char* next = strstr(p + 1, "<trophy ");
+        const char* end = next ? next : p + strlen(p);
+        unsigned id = 0;
+        const char* idp = strstr(p, "id=\"");
+        if (idp && idp < end && sscanf(idp, "id=\"%u\"", &id) == 1 && id < SCE_NP_TROPHY_MAX_NUM_TROPHIES) {
+            const char* t = strstr(p, "ttype=\"");
+            char tt = t && t < end ? t[7] : 'B';
+            ctx->grade[id] = tt == 'P' ? SCE_NP_TROPHY_GRADE_PLATINUM : tt == 'G' ? SCE_NP_TROPHY_GRADE_GOLD :
+                             tt == 'S' ? SCE_NP_TROPHY_GRADE_SILVER : SCE_NP_TROPHY_GRADE_BRONZE;
+            free(ctx->name[id]);
+            ctx->name[id] = sfm_text(p, end, "name");
+            free(ctx->detail[id]);
+            ctx->detail[id] = sfm_text(p, end, "detail");
+            const char* hp = strstr(p, "hidden=\"");
+            ctx->hidden[id] = hp && hp < end && !strncmp(hp + 8, "yes", 3);
+            if (id + 1 > count) count = id + 1;
+        }
+        p = next;
+    }
+    free(ctx->title);
+    ctx->title = sfm_text(sfm, sfm + strlen(sfm), "title-name");
+    free(sfm);
+    if (count) {
+        ctx->total_trophies = count;
+        printf("[sceNpTrophy] trophy set %s: %u trophies\n", ctx->commId.data, count);
+    }
+}
+
+static void trophy_free_set(TrophyContext* ctx)
+{
+    for (u32 i = 0; i < SCE_NP_TROPHY_MAX_NUM_TROPHIES; i++) {
+        free(ctx->name[i]); ctx->name[i] = NULL;
+        free(ctx->detail[i]); ctx->detail[i] = NULL;
+    }
+    free(ctx->title); ctx->title = NULL;
 }
 
