+/* Frame interpolation (included by rsx_vulkan_backend.c after vk_present_window_from).
+ *
+ * The guest runs at its own 30 Hz step. Each new guest frame is copied into a two-slot history, the
+ * motion between the last two frames is estimated on the GPU (symmetric block matching on luma:
+ * 1/4-size search, 1/2-size refinement), and the frames in between are synthesized at the midpoints
+ * and presented by rsx_vulkan_backend_interp_service(), which the host calls from its frame loop.
+ * With factor K the newest guest frame is shown K-1 steps of P/K late (P = guest frame period).
+ *
+ * Passes: luma (rsx_vk_interp_luma.comp), me4, me2, synth. Regenerate the .spv.h files with
+ *   glslangValidator -V --target-env vulkan1.0 -I. --vn rsx_vk_interp_<n>_spv -o rsx_vk_interp_<n>.spv.h \
+ *       rsx_vk_interp_<n>.comp
+ * then `expand -t 4` the output.
+ *
+ * FP_INTERP_TEST=1 measures quality without a window: every second guest frame is held back as ground
+ * truth for the midpoint of its neighbours (a 2-frame gap, so twice the motion of a real 1->2 step), and
+ * the PSNR of the synthesized frame, of a plain 50% blend and of a repeated frame against it is logged.
+ * FP_INTERP_TEST_DIR also writes the first few sets as PPM files.
+ */
+#include "rsx_vk_interp_luma.spv.h"
+#include "rsx_vk_interp_me4.spv.h"
+#include "rsx_vk_interp_me2.spv.h"
+#include "rsx_vk_interp_synth.spv.h"
+
+typedef struct vk_interp_state {
+    int factor;                 /* 1 = off, 2, 4 */
+    int ready, failed, test;
+    u32 w, h;
+    vk_image full[2];           /* guest frame history, slot `cur` is the newest */
+    vk_image l2[2], l4[2];      /* luma pyramids, R32_SFLOAT */
+    vk_image out;               /* synthesized frame */
+    vk_buffer coarse, fine;
+    VkDescriptorSetLayout dsl;
+    VkDescriptorPool pool;
+    VkDescriptorSet set[2];
+    VkPipelineLayout pl;
+    VkShaderModule mod[4];
+    VkPipeline pipe[4];
+    VkSampler samp;
+    VkQueryPool qp;
+    double ts_ms;               /* ms per timestamp tick, 0 = no timestamps */
+    u32 cur, frames;
+    u32 flip, seen_flip;
+    u32 gx4, gy4, gx2, gy2;     /* 8x8 block grids of the 1/4 and 1/2 levels */
+    u32 step;                   /* next step to present, 0 = none pending */
+    uint64_t t0, last_arrival;
+    double period;              /* seconds between guest frames (smoothed) */
+    double gpu_ms[5]; u32 gpu_samples;   /* copy, luma, me4, me2, synth */
+    uint64_t svc_late;
+    /* test mode */
+    vk_buffer rb;
+    unsigned char *cpu[2], *truth;
+    int truth_valid, parity;
+    double psnr_i, psnr_b, psnr_r; u32 psnr_n, dumped;
+} vk_interp_state;
+static vk_interp_state s_ip;
+
+/* The queue must be idle before releasing history or its descriptors. */
+static void vk_interp_release(void)
+{
+    const int factor = s_ip.factor;
+    const u32 flip = s_ip.flip;
+    for (int i = 0; i < 4; ++i) {
+        if (s_ip.pipe[i]) pvkDestroyPipeline(s_vk.device, s_ip.pipe[i], NULL);
+        if (s_ip.mod[i]) pvkDestroyShaderModule(s_vk.device, s_ip.mod[i], NULL);
+    }
+    if (s_ip.pool) pvkDestroyDescriptorPool(s_vk.device, s_ip.pool, NULL);
+    if (s_ip.pl) pvkDestroyPipelineLayout(s_vk.device, s_ip.pl, NULL);
+    if (s_ip.dsl) pvkDestroyDescriptorSetLayout(s_vk.device, s_ip.dsl, NULL);
+    if (s_ip.samp) pvkDestroySampler(s_vk.device, s_ip.samp, NULL);
+    if (s_ip.qp) pvkDestroyQueryPool(s_vk.device, s_ip.qp, NULL);
+    for (int i = 0; i < 2; ++i) {
+        vk_destroy_image(&s_ip.full[i]);
+        vk_destroy_image(&s_ip.l2[i]);
+        vk_destroy_image(&s_ip.l4[i]);
+        free(s_ip.cpu[i]);
+    }
+    vk_destroy_image(&s_ip.out);
+    vk_destroy_buffer(&s_ip.coarse);
+    vk_destroy_buffer(&s_ip.fine);
+    vk_destroy_buffer(&s_ip.rb);
+    free(s_ip.truth);
+    memset(&s_ip, 0, sizeof s_ip);
+    s_ip.factor = factor;
+    s_ip.flip = flip;
+}
+
+enum { IP_LUMA, IP_ME4, IP_ME2, IP_SYNTH };
+
+static int ip_create_images(void)
+{
+    const VkImageUsageFlags full_use = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    for (int i = 0; i < 2; i++) {
+        if (vk_create_image(&s_ip.full[i], VK_FORMAT_R8G8B8A8_UNORM, s_ip.w, s_ip.h, full_use, VK_IMAGE_ASPECT_COLOR_BIT) ||
+            vk_create_image(&s_ip.l2[i], VK_FORMAT_R32_SFLOAT, (s_ip.w + 1) / 2, (s_ip.h + 1) / 2, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT) ||
+            vk_create_image(&s_ip.l4[i], VK_FORMAT_R32_SFLOAT, (s_ip.w + 3) / 4, (s_ip.h + 3) / 4, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT))
+            return -1;
+    }
+    return vk_create_image(&s_ip.out, VK_FORMAT_R8G8B8A8_UNORM, s_ip.w, s_ip.h,
+                           VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT, VK_IMAGE_ASPECT_COLOR_BIT);
+}
+
+static int ip_create_pipelines(void)
+{
+    VkDescriptorSetLayoutBinding b[9];
+    memset(b, 0, sizeof b);
+    for (u32 i = 0; i < 9; i++) {
+        b[i].binding = i; b[i].descriptorCount = 1; b[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        b[i].descriptorType = i < 2 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                            : i < 7 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    }
+    VkDescriptorSetLayoutCreateInfo dli = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 9, .pBindings = b };
+    VK_CHECK(pvkCreateDescriptorSetLayout(s_vk.device, &dli, NULL, &s_ip.dsl), "vkCreateDescriptorSetLayout(interp)");
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 16 };
+    VkPipelineLayoutCreateInfo pli = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                       .setLayoutCount = 1, .pSetLayouts = &s_ip.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pcr };
+    VK_CHECK(pvkCreatePipelineLayout(s_vk.device, &pli, NULL, &s_ip.pl), "vkCreatePipelineLayout(interp)");
+    const struct { const uint32_t* code; size_t bytes; } src[4] = {
+        { rsx_vk_interp_luma_spv, sizeof rsx_vk_interp_luma_spv }, { rsx_vk_interp_me4_spv, sizeof rsx_vk_interp_me4_spv },
+        { rsx_vk_interp_me2_spv, sizeof rsx_vk_interp_me2_spv },   { rsx_vk_interp_synth_spv, sizeof rsx_vk_interp_synth_spv },
+    };
+    for (int i = 0; i < 4; i++) {
+        if (vk_create_shader(src[i].code, src[i].bytes, &s_ip.mod[i])) return -1;
+        VkComputePipelineCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO, .layout = s_ip.pl,
+            .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                       .module = s_ip.mod[i], .pName = "main" } };
+        VK_CHECK(pvkCreateComputePipelines(s_vk.device, s_pipe_cache, 1, &ci, NULL, &s_ip.pipe[i]), "vkCreateComputePipelines(interp)");
+    }
+    return 0;
+}
+
+static int ip_create_descriptors(void)
+{
+    VkDescriptorPoolSize sizes[3] = { { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 4 },
+                                      { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 10 }, { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 4 } };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO, .maxSets = 2,
+                                      .poolSizeCount = 3, .pPoolSizes = sizes };
+    VK_CHECK(pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_ip.pool), "vkCreateDescriptorPool(interp)");
+    VkDescriptorSetLayout layouts[2] = { s_ip.dsl, s_ip.dsl };
+    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO, .descriptorPool = s_ip.pool,
+                                       .descriptorSetCount = 2, .pSetLayouts = layouts };
+    VK_CHECK(pvkAllocateDescriptorSets(s_vk.device, &ai, s_ip.set), "vkAllocateDescriptorSets(interp)");
+    VkSamplerCreateInfo sci = { .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO, .magFilter = VK_FILTER_LINEAR,
+        .minFilter = VK_FILTER_LINEAR, .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE };
+    VK_CHECK(pvkCreateSampler(s_vk.device, &sci, NULL, &s_ip.samp), "vkCreateSampler(interp)");
+    for (u32 k = 0; k < 2; k++) {
+        const u32 p = 1 - k;           /* set k: slot k is the newest frame */
+        VkDescriptorImageInfo ci[2] = { { s_ip.samp, s_ip.full[p].view, VK_IMAGE_LAYOUT_GENERAL },
+                                        { s_ip.samp, s_ip.full[k].view, VK_IMAGE_LAYOUT_GENERAL } };
+        VkDescriptorImageInfo si[5] = { { VK_NULL_HANDLE, s_ip.l2[p].view, VK_IMAGE_LAYOUT_GENERAL },
+                                        { VK_NULL_HANDLE, s_ip.l2[k].view, VK_IMAGE_LAYOUT_GENERAL },
+                                        { VK_NULL_HANDLE, s_ip.l4[p].view, VK_IMAGE_LAYOUT_GENERAL },
+                                        { VK_NULL_HANDLE, s_ip.l4[k].view, VK_IMAGE_LAYOUT_GENERAL },
+                                        { VK_NULL_HANDLE, s_ip.out.view, VK_IMAGE_LAYOUT_GENERAL } };
+        VkDescriptorBufferInfo bi[2] = { { s_ip.coarse.buf, 0, VK_WHOLE_SIZE }, { s_ip.fine.buf, 0, VK_WHOLE_SIZE } };
+        VkWriteDescriptorSet w[9];
+        memset(w, 0, sizeof w);
+        for (u32 i = 0; i < 9; i++) {
+            w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w[i].dstSet = s_ip.set[k];
+            w[i].dstBinding = i; w[i].descriptorCount = 1;
+            if (i < 2)      { w[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER; w[i].pImageInfo = &ci[i]; }
+            else if (i < 7) { w[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE; w[i].pImageInfo = &si[i - 2]; }
+            else            { w[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; w[i].pBufferInfo = &bi[i - 7]; }
+        }
+        pvkUpdateDescriptorSets(s_vk.device, 9, w, 0, NULL);
+    }
+    return 0;
+}
+
+static int vk_interp_init(void)
+{
+    s_ip.w = s_vk.width; s_ip.h = s_vk.height;
+    s_ip.gx4 = (((s_ip.w + 3) / 4) + 7) / 8; s_ip.gy4 = (((s_ip.h + 3) / 4) + 7) / 8;
+    s_ip.gx2 = (((s_ip.w + 1) / 2) + 7) / 8; s_ip.gy2 = (((s_ip.h + 1) / 2) + 7) / 8;
+    if (ip_create_images() ||
+        vk_create_host_buffer(&s_ip.coarse, (VkDeviceSize)s_ip.gx4 * s_ip.gy4 * 8, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+        vk_create_host_buffer(&s_ip.fine, (VkDeviceSize)s_ip.gx2 * s_ip.gy2 * 16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT) ||
+        ip_create_pipelines() || ip_create_descriptors()) {
+        VK_LOG("frame interpolation unavailable\n");
+        s_ip.failed = 1; return -1;
+    }
+    VkPhysicalDeviceProperties props;
+    pvkGetPhysicalDeviceProperties(s_vk.phys, &props);
+    u32 nq = 0; VkQueueFamilyProperties qf[64];
+    pvkGetPhysicalDeviceQueueFamilyProperties(s_vk.phys, &nq, NULL);
+    if (nq > 64) nq = 64;
+    pvkGetPhysicalDeviceQueueFamilyProperties(s_vk.phys, &nq, qf);
+    if (s_vk.queue_family < nq && qf[s_vk.queue_family].timestampValidBits >= 32 && props.limits.timestampPeriod > 0.f) {
+        VkQueryPoolCreateInfo qi = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = 6 };
+        if (pvkCreateQueryPool(s_vk.device, &qi, NULL, &s_ip.qp) == VK_SUCCESS) s_ip.ts_ms = props.limits.timestampPeriod * 1e-6;
+    }
+    s_ip.test = getenv("FP_INTERP_TEST") && strcmp(getenv("FP_INTERP_TEST"), "0");
+    if (s_ip.test) {
+        const size_t bytes = (size_t)s_ip.w * s_ip.h * 4;
+        s_ip.cpu[0] = (unsigned char*)malloc(bytes); s_ip.cpu[1] = (unsigned char*)malloc(bytes);
+        s_ip.truth = (unsigned char*)malloc(bytes);
+        if (!s_ip.cpu[0] || !s_ip.cpu[1] || !s_ip.truth || vk_create_host_buffer(&s_ip.rb, bytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) {
+            s_ip.failed = 1; return -1;
+        }
+    }
+    /* All images live in GENERAL (see the file header); move them there once. */
+    if ((s_begin_reason = "interp_init", vk_begin())) { s_ip.failed = 1; return -1; }
+    for (int i = 0; i < 2; i++) {
+        vk_barrier_image(s_ip.full[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_barrier_image(s_ip.l2[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_barrier_image(s_ip.l4[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    }
+    vk_barrier_image(s_ip.out.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    if ((s_submit_reason = "interp_init", vk_submit_and_wait())) { s_ip.failed = 1; return -1; }
+    s_ip.ready = 1; s_ip.period = 1.0 / 30.0;
+    VK_LOG("frame interpolation ready (%ux%u, %s timestamps%s)\n", s_ip.w, s_ip.h, s_ip.ts_ms > 0 ? "with" : "no",
+           s_ip.test ? ", test mode" : "");
+    return 0;
+}
+
+static void ip_pass_barrier(void)
+{
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static void ip_dispatch(int pass, u32 gx, u32 gy, float phase)
+{
+    static int skip = -1;   /* FP_INTERP_SKIP: bit n skips pass n (luma, me4, me2, synth), for bisecting a driver problem */
+    if (skip < 0) skip = getenv("FP_INTERP_SKIP") ? atoi(getenv("FP_INTERP_SKIP")) : 0;
+    if (skip & (1 << pass)) return;
+    const float pc[4] = { phase, 0.14f, 0.f, 0.f };   /* y: blocks matching worse than this mean luma error use no motion */
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_ip.pipe[pass]);
+    pvkCmdPushConstants(s_vk.cmd, s_ip.pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    pvkCmdDispatch(s_vk.cmd, gx, gy, 1);
+    ip_pass_barrier();
+}
+
+static int ip_skip(int bit) { const char* e = getenv("FP_INTERP_SKIP"); return e && (atoi(e) & bit); }
+
+static void ip_stamp(u32 i)
+{
+    if (s_ip.qp && !ip_skip(32)) pvkCmdWriteTimestamp(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, s_ip.qp, i);
+}
+
+/* New guest frame: copy it into the history, build its luma pyramid and, when there is a previous
+ * frame, estimate the motion. The recorded commands stay open for the caller to add a synth pass. */
+static int ip_record_analyze(void)
+{
+    if ((s_begin_reason = "interp_frame", vk_begin())) return -1;
+    if (s_ip.qp && !ip_skip(32)) pvkCmdResetQueryPool(s_vk.cmd, s_ip.qp, 0, 6);
+    vk_barrier_image(s_vk.color.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    ip_stamp(0);
+    VkImageCopy cp = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .extent = { s_ip.w, s_ip.h, 1 } };
+    if (!(getenv("FP_INTERP_SKIP") && (atoi(getenv("FP_INTERP_SKIP")) & 16)))
+        pvkCmdCopyImage(s_vk.cmd, s_vk.color.img, VK_IMAGE_LAYOUT_GENERAL, s_ip.full[s_ip.cur].img, VK_IMAGE_LAYOUT_GENERAL, 1, &cp);
+    ip_pass_barrier();
+    ip_stamp(1);
+    if (!ip_skip(64)) pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_ip.pl, 0, 1, &s_ip.set[s_ip.cur], 0, NULL);
+    ip_dispatch(IP_LUMA, (((s_ip.w + 3) / 4) + 7) / 8, (((s_ip.h + 3) / 4) + 7) / 8, 0.f);
+    ip_stamp(2);
+    if (s_ip.frames >= 1) {
+        ip_dispatch(IP_ME4, s_ip.gx4, s_ip.gy4, 0.f);
+        ip_stamp(3);
+        ip_dispatch(IP_ME2, s_ip.gx2, s_ip.gy2, 0.f);
+    }
+    ip_stamp(4);
+    return 0;
+}
+
+static void ip_record_synth(float phase)
+{
+    ip_dispatch(IP_SYNTH, (s_ip.w + 15) / 16, (s_ip.h + 15) / 16, phase);
+    ip_stamp(5);
+}
+
+/* GPU ms per guest frame over the last 120 frames, for the host's stats overlay; 0 until measured. */
+static double s_ip_last_total_ms;
+double rsx_vulkan_backend_interp_gpu_ms(void) { return s_ip_last_total_ms; }
+
+static void ip_collect_timestamps(void)
+{
+    if (!s_ip.qp) return;
+    uint64_t t[6] = { 0 };
+    if (pvkGetQueryPoolResults(s_vk.device, s_ip.qp, 0, 6, sizeof t, t, sizeof t[0],
+                               VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) != VK_SUCCESS) return;
+    for (int i = 0; i < 5; i++) s_ip.gpu_ms[i] += (double)(t[i + 1] - t[i]) * s_ip.ts_ms;
+    if (++s_ip.gpu_samples >= 120) {
+        const double n = (double)s_ip.gpu_samples;
+        s_ip_last_total_ms = (s_ip.gpu_ms[0] + s_ip.gpu_ms[1] + s_ip.gpu_ms[2] + s_ip.gpu_ms[3] + s_ip.gpu_ms[4]) / n;
+        fprintf(stderr, "[fp-interp] gpu ms per guest frame: copy %.3f luma %.3f me4 %.3f me2 %.3f synth %.3f (synth runs x%d), period %.1f ms\n",
+                s_ip.gpu_ms[0] / n, s_ip.gpu_ms[1] / n, s_ip.gpu_ms[2] / n, s_ip.gpu_ms[3] / n, s_ip.gpu_ms[4] / n,
+                s_ip.factor - 1, s_ip.period * 1000.0);
+        memset(s_ip.gpu_ms, 0, sizeof s_ip.gpu_ms); s_ip.gpu_samples = 0;
+    }
+}
+
+static double ip_psnr(const unsigned char* a, const unsigned char* b)
+{
+    double se = 0; const size_t n = (size_t)s_ip.w * s_ip.h;
+    for (size_t i = 0; i < n; i++)
+        for (int c = 0; c < 3; c++) { double d = (double)a[i * 4 + c] - (double)b[i * 4 + c]; se += d * d; }
+    se /= (double)(n * 3);
+    return se <= 0 ? 99.0 : 10.0 * log10(255.0 * 255.0 / se);
+}
+
+static void ip_test_compare(void)
+{
+    /* cpu[cur] holds the newest even frame, cpu[1-cur] the one before it. */
+    const size_t bytes = (size_t)s_ip.w * s_ip.h * 4;
+    if (!s_ip.truth_valid || s_ip.frames < 2) return;
+    vk_invalidate(&s_ip.rb);
+    const unsigned char* mid = (const unsigned char*)s_ip.rb.ptr;
+    const unsigned char* prev = s_ip.cpu[1 - s_ip.cur];
+    const unsigned char* cur = s_ip.cpu[s_ip.cur];
+    unsigned char* blend = (unsigned char*)malloc(bytes);
+    if (!blend) return;
+    for (size_t i = 0; i < bytes; i++) blend[i] = (unsigned char)(((unsigned)prev[i] + cur[i] + 1) / 2);
+    const double pi = ip_psnr(mid, s_ip.truth), pb = ip_psnr(blend, s_ip.truth), pr = ip_psnr(prev, s_ip.truth);
+    s_ip.psnr_i += pi; s_ip.psnr_b += pb; s_ip.psnr_r += pr;
+    free(blend);
+    ++s_ip.psnr_n;
+    const char* dir = getenv("FP_INTERP_TEST_DIR");
+    if (dir && *dir && s_ip.dumped < 8 && pr < 27.0 && s_ip.psnr_n % 7 == 0) {   /* only frames with real motion */
+        const unsigned char* set[4] = { prev, cur, s_ip.truth, mid };
+        const char* nm[4] = { "prev", "cur", "truth", "mid" };
+        for (int k = 0; k < 4; k++) {
+            char path[1024]; snprintf(path, sizeof path, "%s/%s-%02u.ppm", dir, nm[k], s_ip.dumped);
+            vk_dump_ppm(set[k], path);
+        }
+        ++s_ip.dumped;
+    }
+    if (s_ip.psnr_n % 20 == 0)
+        fprintf(stderr, "[fp-interp-test] %u pairs: PSNR synthesized %.2f dB, 50%% blend %.2f dB, repeat %.2f dB\n", s_ip.psnr_n,
+                s_ip.psnr_i / s_ip.psnr_n, s_ip.psnr_b / s_ip.psnr_n, s_ip.psnr_r / s_ip.psnr_n);
+    s_ip.truth_valid = 0;
+}
+
+static double ip_now(void) { return (double)SDL_GetPerformanceCounter() / (double)SDL_GetPerformanceFrequency(); }
+
+/* Called for every frame vk_cb_present has finished reading back. Returns 1 when the interpolation
+ * path took over presenting (the first step is already on screen). */
+static int vk_interp_frame(void)
+{
+    if (s_ip.factor <= 1 && !getenv("FP_INTERP_TEST")) return 0;
+    if (!s_ip.ready && !s_ip.failed) vk_interp_init();
+    if (!s_ip.ready) return 0;
+    if (s_ip.test) { if (s_ip.factor <= 1) s_ip.factor = 2; }
+    if (s_ip.flip == s_ip.seen_flip && !s_ip.test) return 0;      /* a repeat present, not a new guest frame */
+    s_ip.seen_flip = s_ip.flip;
+
+    const double now = ip_now();
+    if (s_ip.last_arrival) {
+        const double dt = now - (double)s_ip.last_arrival * 1e-9;
+        if (dt > 0.008 && dt < 0.12) s_ip.period = 0.9 * s_ip.period + 0.1 * dt;
+    }
+    s_ip.last_arrival = (uint64_t)(now * 1e9);
+
+    const size_t bytes = (size_t)s_ip.w * s_ip.h * 4;
+    if (s_ip.test) {
+        if (s_ip.parity++ & 1) {                                /* odd frame: ground truth */
+            memcpy(s_ip.truth, s_vk.readback.ptr, bytes); s_ip.truth_valid = 1;
+            return 1;
+        }
+    }
+    s_ip.cur ^= 1;
+    if (s_ip.test) memcpy(s_ip.cpu[s_ip.cur], s_vk.readback.ptr, bytes);
+    if (ip_skip(128)) return s_ip.test;
+    if (ip_record_analyze()) return 0;
+    const int have_pair = s_ip.frames >= 1;
+    if (have_pair) {
+        ip_record_synth(s_ip.test ? 0.5f : 1.0f / (float)s_ip.factor);
+        if (s_ip.test) {
+            VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { s_ip.w, s_ip.h, 1 } };
+            pvkCmdCopyImageToBuffer(s_vk.cmd, s_ip.out.img, VK_IMAGE_LAYOUT_GENERAL, s_ip.rb.buf, 1, &region);
+            VkBufferMemoryBarrier host = { .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_HOST_READ_BIT, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .buffer = s_ip.rb.buf, .size = VK_WHOLE_SIZE };
+            pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, NULL, 1, &host, 0, NULL);
+        }
+    }
+    s_submit_reason = "interp_frame";
+    if (vk_submit_and_wait()) return 0;
+    if (have_pair && !ip_skip(32)) ip_collect_timestamps();   /* queries 3 to 5 are only written with a pair and a synth pass */
+    ++s_ip.frames;
+    if (s_ip.test) ip_test_compare();
+    if (!have_pair || s_ip.test) return s_ip.test;
+    s_ip.t0 = (uint64_t)(now * 1e9);
+    s_ip.step = s_ip.factor > 1 ? 2 : 0;
+    vk_present_window_from(s_ip.out.img);
+    return 1;
+}
+
+void rsx_vulkan_backend_set_interp(int factor)
+{
+    if (factor != 1 && factor != 2 && factor != 4) factor = 1;
+    if (factor == s_ip.factor || getenv("FP_INTERP_TEST")) return;
+    s_ip.factor = factor; s_ip.frames = 0; s_ip.step = 0;
+}
+
+void rsx_vulkan_backend_interp_flip(u32 flips) { s_ip.flip = flips; }
+
+/* The host's frame loop calls this every iteration: presents the next in-between frame (or the real
+ * newest frame as the last step) when its time has come. */
+void rsx_vulkan_backend_interp_service(void)
+{
+    if (!s_ip.step || !s_ip.ready) return;
+    if (s_ip.factor <= 1) { s_ip.step = 0; return; }
+    const double due = (double)s_ip.t0 * 1e-9 + (double)(s_ip.step - 1) * s_ip.period / (double)s_ip.factor;
+    if (ip_now() < due) return;
+    if (!s_vk.windowed) { s_ip.step = 0; return; }
+    if (s_ip.step < (u32)s_ip.factor) {
+        if ((s_begin_reason = "interp_step", vk_begin())) { s_ip.step = 0; return; }
+        pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_ip.pl, 0, 1, &s_ip.set[s_ip.cur], 0, NULL);
+        ip_dispatch(IP_SYNTH, (s_ip.w + 15) / 16, (s_ip.h + 15) / 16, (float)s_ip.step / (float)s_ip.factor);
+        s_submit_reason = "interp_step";
+        if (vk_submit_and_wait()) { s_ip.step = 0; return; }
+        vk_present_window_from(s_ip.out.img);
+    } else {
+        vk_present_window_from(s_ip.full[s_ip.cur].img);
+    }
+    s_ip.step = s_ip.step >= (u32)s_ip.factor ? 0 : s_ip.step + 1;
+}
diff --git a/libs/video/vulkan/rsx_vk_interp_common.glsl b/libs/video/vulkan/rsx_vk_interp_common.glsl
new file mode 100644
index 00000000..b844bf68
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_interp_common.glsl
@@ -0,0 +1,16 @@
+// Shared bindings for the frame interpolation compute passes (one descriptor set layout).
+// Passes include this text after a #version line; see rsx_vulkan_backend.c for the host side.
+layout(set = 0, binding = 0) uniform sampler2D uPrev;                 // previous guest frame, full size
+layout(set = 0, binding = 1) uniform sampler2D uCur;                  // newest guest frame
+layout(set = 0, binding = 2, r32f) uniform image2D uL2Prev;           // luma at 1/2 size
+layout(set = 0, binding = 3, r32f) uniform image2D uL2Cur;
+layout(set = 0, binding = 4, r32f) uniform image2D uL4Prev;           // luma at 1/4 size
+layout(set = 0, binding = 5, r32f) uniform image2D uL4Cur;
+layout(set = 0, binding = 6, rgba8) uniform image2D uOut;             // synthesized frame
+layout(set = 0, binding = 7, std430) buffer Coarse { ivec2 coarse[]; };
+struct FineBlock { int dx, dy; float err; float zero_err; };
+layout(set = 0, binding = 8, std430) buffer Fine { FineBlock fine[]; };
+layout(push_constant) uniform PC { vec4 p; } pc;                       // x: phase, y: bad-match threshold
+
+// imageLoad with the coordinate clamped to the image
+#define LUMA_AT(im, c) imageLoad(im, clamp((c), ivec2(0), imageSize(im) - 1)).r
diff --git a/libs/video/vulkan/rsx_vk_interp_luma.comp b/libs/video/vulkan/rsx_vk_interp_luma.comp
new file mode 100644
index 00000000..6551440c
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_interp_luma.comp
@@ -0,0 +1,26 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+// One thread per 1/4-size pixel: the 1/2-size luma of its 2x2 children and their mean for the 1/4 level.
+layout(local_size_x = 8, local_size_y = 8) in;
+#include "rsx_vk_interp_common.glsl"
+float luma_tap(ivec2 p2)
+{
+    // A linear tap on the centre of a 2x2 texel group is that group's mean.
+    vec2 uv = (vec2(p2) * 2.0 + 1.0) / vec2(textureSize(uCur, 0));
+    return dot(texture(uCur, uv).rgb, vec3(0.299, 0.587, 0.114));
+}
+void main()
+{
+    ivec2 p4 = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 s4 = imageSize(uL4Cur), s2 = imageSize(uL2Cur);
+    if (p4.x >= s4.x || p4.y >= s4.y) return;
+    float sum = 0.0;
+    for (int j = 0; j < 2; j++)
+        for (int i = 0; i < 2; i++) {
+            ivec2 q = p4 * 2 + ivec2(i, j);
+            float l = luma_tap(min(q, s2 - 1));
+            if (q.x < s2.x && q.y < s2.y) imageStore(uL2Cur, q, vec4(l));
+            sum += l;
+        }
+    imageStore(uL4Cur, p4, vec4(sum * 0.25));
+}
