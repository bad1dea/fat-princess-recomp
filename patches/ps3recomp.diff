+extern __declspec(thread) int g_spu_rz;
+#else
+extern __thread int g_spu_rz __attribute__((tls_model("initial-exec")));
+#endif
+/* Under RZ + FTZ + DAZ an operand with biased exponent 255 is Inf or NaN to x86 and makes the result Inf or NaN,
+ * and an overflow truncates to FLT_MAX, so one test of the result's exponent (>= 254) finds every lane that needs
+ * the exact path. A zero result (exponent 0 after FTZ) is returned as +0. */
+SPU__X_INLINE u128 spu__x_native_fix(__m128i r, int* ok) {
+    const __m128i e = _mm_and_si128(_mm_srli_epi32(r, 23), _mm_set1_epi32(0xFF));
+    const __m128i big = _mm_cmpgt_epi32(e, _mm_set1_epi32(253));
+    *ok = _mm_testz_si128(big, big) & g_spu_rz;
+    return spu__x_st(_mm_andnot_si128(_mm_cmpeq_epi32(e, _mm_setzero_si128()), r));
