+/* Guest shader translation (HLSL through glslang) takes 5 to 60 ms per program and every new pipeline
+ * does it on the FIFO thread, which shows up as single slow frames. The SPIR-V is kept on disk under
+ * FP_SHADER_CACHE_DIR, keyed on a hash of the stage and the generated HLSL, so only the first play
+ * through pays. Bump SHADER_CACHE_VERSION when the translator's output changes. */
+#define SHADER_CACHE_VERSION 1u
+void rsx_vulkan_backend_set_disk_cache(int on) { s_disk_cache_off = !on; }
+static const char* vk_shader_cache_dir(void)
+{
+    static const char* dir = (const char*)-1;
+    if (dir == (const char*)-1) { dir = getenv("FP_SHADER_CACHE_DIR"); if (dir && !*dir) dir = NULL; }
+    return s_disk_cache_off ? NULL : dir;
+}
+static void vk_shader_cache_path(char* out, size_t cap, const char* hlsl, int stage)
+{
+    uint64_t h = 1469598103934665603ull ^ (uint64_t)stage ^ ((uint64_t)SHADER_CACHE_VERSION << 8);
+    size_t n = 0;
+    for (const unsigned char* c = (const unsigned char*)hlsl; *c; c++, n++) { h ^= *c; h *= 1099511628211ull; }
+    snprintf(out, cap, "%s/%016llx-%zx-%d.spv", vk_shader_cache_dir(), (unsigned long long)h, n, stage);
+}
+static int vk_shader_cache_load(const char* hlsl, int stage, u32* words)
+{
+    if (!vk_shader_cache_dir()) return 0;
+    char path[600];
+    vk_shader_cache_path(path, sizeof path, hlsl, stage);
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    const size_t got = fread(s_g.spv, 4, VK_SPV_WORDS, f);
+    fclose(f);
+    if (!got || s_g.spv[0] != 0x07230203u) return 0;
+    *words = (u32)got;
+    return 1;
+}
+static void vk_shader_cache_store(const char* hlsl, int stage, u32 words)
+{
+    if (!vk_shader_cache_dir()) return;
+    char path[600], tmp[640];
+    vk_shader_cache_path(path, sizeof path, hlsl, stage);
+    snprintf(tmp, sizeof tmp, "%s.tmp%d", path, (int)getpid());
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    const int ok = fwrite(s_g.spv, 4, words, f) == words;
+    fclose(f);
+    if (ok) rename(tmp, path); else remove(tmp);
+}
