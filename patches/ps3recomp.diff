+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                          FSR - [LFGA] LINEAR FILM GRAIN APPLICATOR
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// Adding output-resolution film grain after scaling is a good way to mask both rendering and scaling artifacts.
+// Suggest using tiled blue noise as film grain input, with peak noise frequency set for a specific look and feel.
+// The 'Lfga*()' functions provide a convenient way to introduce grain.
+// These functions limit grain based on distance to signal limits.
+// This is done so that the grain is temporally energy preserving, and thus won't modify image tonality.
+// Grain application should be done in a linear colorspace.
+// The grain should be temporally changing, but have a temporal sum per pixel that adds to zero (non-biased).
+//------------------------------------------------------------------------------------------------------------------------------
+// Usage,
+//   FsrLfga*(
+//    color, // In/out linear colorspace color {0 to 1} ranged.
+//    grain, // Per pixel grain texture value {-0.5 to 0.5} ranged, input is 3-channel to support colored grain.
+//    amount); // Amount of grain (0 to 1} ranged.
+//------------------------------------------------------------------------------------------------------------------------------
+// Example if grain texture is monochrome: 'FsrLfgaF(color,AF3_(grain),amount)'
+//==============================================================================================================================
+#if defined(A_GPU)
+ // Maximum grain is the minimum distance to the signal limit.
+ void FsrLfgaF(inout AF3 c,AF3 t,AF1 a){c+=(t*AF3_(a))*min(AF3_(1.0)-c,c);}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ // Half precision version (slower).
+ void FsrLfgaH(inout AH3 c,AH3 t,AH1 a){c+=(t*AH3_(a))*min(AH3_(1.0)-c,c);}
+//------------------------------------------------------------------------------------------------------------------------------
+ // Packed half precision version (faster).
+ void FsrLfgaHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 tR,AH2 tG,AH2 tB,AH1 a){
+  cR+=(tR*AH2_(a))*min(AH2_(1.0)-cR,cR);cG+=(tG*AH2_(a))*min(AH2_(1.0)-cG,cG);cB+=(tB*AH2_(a))*min(AH2_(1.0)-cB,cB);}
+#endif
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                          FSR - [SRTM] SIMPLE REVERSIBLE TONE-MAPPER
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// This provides a way to take linear HDR color {0 to FP16_MAX} and convert it into a temporary {0 to 1} ranged post-tonemapped linear.
+// The tonemapper preserves RGB ratio, which helps maintain HDR color bleed during filtering.
+//------------------------------------------------------------------------------------------------------------------------------
+// Reversible tonemapper usage,
+//  FsrSrtm*(color); // {0 to FP16_MAX} converted to {0 to 1}.
+//  FsrSrtmInv*(color); // {0 to 1} converted into {0 to 32768, output peak safe for FP16}.
+//==============================================================================================================================
+#if defined(A_GPU)
+ void FsrSrtmF(inout AF3 c){c*=AF3_(ARcpF1(AMax3F1(c.r,c.g,c.b)+AF1_(1.0)));}
+ // The extra max solves the c=1.0 case (which is a /0).
+ void FsrSrtmInvF(inout AF3 c){c*=AF3_(ARcpF1(max(AF1_(1.0/32768.0),AF1_(1.0)-AMax3F1(c.r,c.g,c.b))));}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ void FsrSrtmH(inout AH3 c){c*=AH3_(ARcpH1(AMax3H1(c.r,c.g,c.b)+AH1_(1.0)));}
+ void FsrSrtmInvH(inout AH3 c){c*=AH3_(ARcpH1(max(AH1_(1.0/32768.0),AH1_(1.0)-AMax3H1(c.r,c.g,c.b))));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrSrtmHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB){
+  AH2 rcp=ARcpH2(AMax3H2(cR,cG,cB)+AH2_(1.0));cR*=rcp;cG*=rcp;cB*=rcp;}
+ void FsrSrtmInvHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB){
+  AH2 rcp=ARcpH2(max(AH2_(1.0/32768.0),AH2_(1.0)-AMax3H2(cR,cG,cB)));cR*=rcp;cG*=rcp;cB*=rcp;}
+#endif
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                       FSR - [TEPD] TEMPORAL ENERGY PRESERVING DITHER
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// Temporally energy preserving dithered {0 to 1} linear to gamma 2.0 conversion.
+// Gamma 2.0 is used so that the conversion back to linear is just to square the color.
+// The conversion comes in 8-bit and 10-bit modes, designed for output to 8-bit UNORM or 10:10:10:2 respectively.
+// Given good non-biased temporal blue noise as dither input,
+// the output dither will temporally conserve energy.
+// This is done by choosing the linear nearest step point instead of perceptual nearest.
+// See code below for details.
+//------------------------------------------------------------------------------------------------------------------------------
+// DX SPEC RULES FOR FLOAT->UNORM 8-BIT CONVERSION
+// ===============================================
+// - Output is 'uint(floor(saturate(n)*255.0+0.5))'.
+// - Thus rounding is to nearest.
+// - NaN gets converted to zero.
+// - INF is clamped to {0.0 to 1.0}.
+//==============================================================================================================================
+#if defined(A_GPU)
+ // Hand tuned integer position to dither value, with more values than simple checkerboard.
+ // Only 32-bit has enough precision for this compddation.
+ // Output is {0 to <1}.
+ AF1 FsrTepdDitF(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  // The 1.61803 golden ratio.
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  // Number designed to provide a good visual pattern.
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AFractF1(x);}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 8-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC8F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(255.0))*AF3_(1.0/255.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/255.0);b=b*b;
+  // Ratio of 'a' to 'b' required to produce 'c'.
+  // APrxLoRcpF1() won't work here (at least for very high dynamic ranges).
+  // APrxMedRcpF1() is an IADD,FMA,MUL.
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  // Use the ratio as a cutoff to choose 'a' or 'b'.
+  // AGtZeroF1() is a MUL.
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 10-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC10F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(1023.0))*AF3_(1.0/1023.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/1023.0);b=b*b;
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/1023.0));}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ AH1 FsrTepdDitH(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AH1(AFractF1(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(255.0))*AH3_(1.0/255.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/255.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(1023.0))*AH3_(1.0/1023.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/1023.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/1023.0));}
+//==============================================================================================================================
+ // This computes dither for positions 'p' and 'p+{8,0}'.
+ AH2 FsrTepdDitHx2(AU2 p,AU1 f){
+  AF2 x;
+  x.x=AF1_(p.x+f);
+  x.y=x.x+AF1_(8.0);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*AF2_(a)+AF2_(y*b);
+  return AH2(AFractF2(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(255.0))*AH2_(1.0/255.0);
+  nG=floor(nG*AH2_(255.0))*AH2_(1.0/255.0);
+  nB=floor(nB*AH2_(255.0))*AH2_(1.0/255.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/255.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/255.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/255.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/255.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/255.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nG=floor(nG*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nB=floor(nB*AH2_(1023.0))*AH2_(1.0/1023.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/1023.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/1023.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/1023.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/1023.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/1023.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/1023.0));}
+#endif
diff --git a/libs/video/vulkan/rsx_vk_fsr.comp b/libs/video/vulkan/rsx_vk_fsr.comp
new file mode 100644
index 00000000..2f9377da
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_fsr.comp
@@ -0,0 +1,55 @@
+// AMD FidelityFX Super Resolution 1.0: EASU (upscale) and RCAS (sharpen), wired the way AMD's sample does it.
+// ffx_a.h and ffx_fsr1.h are AMD's, MIT licensed (their headers carry the notice).
+// Regenerate: glslangValidator -V --target-env vulkan1.0 -I. -DSAMPLE_EASU=1 --vn rsx_vk_fsr_easu_spv -o rsx_vk_fsr_easu.spv.h rsx_vk_fsr.comp
+//             glslangValidator -V --target-env vulkan1.0 -I. -DSAMPLE_RCAS=1 --vn rsx_vk_fsr_rcas_spv -o rsx_vk_fsr_rcas.spv.h rsx_vk_fsr.comp
+// then `expand -t 4` both outputs.
+#version 450
+#extension GL_GOOGLE_include_directive : require
+layout(set = 0, binding = 0) uniform sampler2D InputTexture;
+layout(set = 0, binding = 1, rgba8) uniform writeonly image2D OutputTexture;
+layout(push_constant) uniform FsrConstants { uvec4 Const0; uvec4 Const1; uvec4 Const2; uvec4 Const3; };
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+
+#if SAMPLE_EASU
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return AF4(textureGather(InputTexture, p, 0)); }
+AF4 FsrEasuGF(AF2 p) { return AF4(textureGather(InputTexture, p, 1)); }
+AF4 FsrEasuBF(AF2 p) { return AF4(textureGather(InputTexture, p, 2)); }
+#endif
+#if SAMPLE_RCAS
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return AF4(texelFetch(InputTexture, ASU2(p), 0)); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#endif
+
+#include "ffx_fsr1.h"
+
+void CurrFilter(AU2 pos)
+{
+#if SAMPLE_EASU
+    AF3 c;
+    FsrEasuF(c, pos, Const0, Const1, Const2, Const3);
+    imageStore(OutputTexture, ASU2(pos), AF4(c, 1.0));
+#endif
+#if SAMPLE_RCAS
+    AF3 c;
+    FsrRcasF(c.r, c.g, c.b, pos, Const0);
+    imageStore(OutputTexture, ASU2(pos), AF4(c, 1.0));
+#endif
+}
+
+layout(local_size_x = 64) in;
+void main()
+{
+    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
+    CurrFilter(gxy);
+    gxy.x += 8u;
+    CurrFilter(gxy);
+    gxy.y += 8u;
+    CurrFilter(gxy);
+    gxy.x -= 8u;
+    CurrFilter(gxy);
+}
diff --git a/libs/video/vulkan/rsx_vk_fsr.inc b/libs/video/vulkan/rsx_vk_fsr.inc
new file mode 100644
index 00000000..5c07fa7c
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_fsr.inc
@@ -0,0 +1,168 @@
+/* FidelityFX Super Resolution 1.0 for the presented frame (included by rsx_vulkan_backend.c after the interpolation
+ * code). When the surface the title presents is smaller than the display image (RENDER SCALE under 1X) it is
+ * upscaled with EASU, then sharpened with RCAS, instead of the plain linear blit. RSX_UPSCALER=fsr turns it on,
+ * RSX_FSR_SHARPNESS is RCAS's stops of reduction (0 = sharpest, default 0.25).
+ *
+ * The shaders are AMD's (vulkan/ffx_a.h, ffx_fsr1.h, MIT). Two compute passes, each 16x16 output pixels per group:
+ * the input view -> image A (EASU), A -> image B (RCAS). The caller copies B onto the display image.
+ */
+#include "rsx_vk_fsr_easu.spv.h"
+#include "rsx_vk_fsr_rcas.spv.h"
+
+typedef struct vk_fsr_state {
+    int enabled, ready, failed;
+    float sharpness;
+    vk_image a, b;
+    VkDescriptorSetLayout dsl;
+    VkDescriptorPool pool;
+    VkDescriptorSet set_easu, set_rcas;
+    VkPipelineLayout pl;
+    VkShaderModule mod[2];
+    VkPipeline pipe[2];
+    VkSampler samp;
+    uint32_t w, h;
+} vk_fsr_state;
+static vk_fsr_state s_fsr;
+static int fsr_user_set;      /* the host menu has spoken: RSX_UPSCALER and RSX_FSR_SHARPNESS no longer apply */
+
+static void vk_fsr_release(void)
+{
+    const int enabled = s_fsr.enabled;
+    const float sharpness = s_fsr.sharpness;
+    for (int i = 0; i < 2; ++i) {
+        if (s_fsr.pipe[i]) pvkDestroyPipeline(s_vk.device, s_fsr.pipe[i], NULL);
+        if (s_fsr.mod[i]) pvkDestroyShaderModule(s_vk.device, s_fsr.mod[i], NULL);
+    }
+    if (s_fsr.pool) pvkDestroyDescriptorPool(s_vk.device, s_fsr.pool, NULL);
+    if (s_fsr.pl) pvkDestroyPipelineLayout(s_vk.device, s_fsr.pl, NULL);
+    if (s_fsr.dsl) pvkDestroyDescriptorSetLayout(s_vk.device, s_fsr.dsl, NULL);
+    if (s_fsr.samp) pvkDestroySampler(s_vk.device, s_fsr.samp, NULL);
+    vk_destroy_image(&s_fsr.a);
+    vk_destroy_image(&s_fsr.b);
+    memset(&s_fsr, 0, sizeof s_fsr);
+    s_fsr.enabled = enabled;
+    s_fsr.sharpness = sharpness;
+}
+
+static uint32_t fsr_bits(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+
+static int vk_fsr_init(void)
+{
+    if (fsr_user_set) return 0;
+    const char* up = getenv("RSX_UPSCALER");
+    s_fsr.enabled = up && !strcmp(up, "fsr");
+    const char* sh = getenv("RSX_FSR_SHARPNESS");
+    s_fsr.sharpness = sh ? (float)atof(sh) : 0.25f;
+    return 0;
+}
+
+static int vk_fsr_create(void)
+{
+    s_fsr.w = s_vk.width; s_fsr.h = s_vk.height;
+    const VkImageUsageFlags use = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    if (vk_create_image(&s_fsr.a, VK_FORMAT_R8G8B8A8_UNORM, s_fsr.w, s_fsr.h, use, VK_IMAGE_ASPECT_COLOR_BIT) ||
+        vk_create_image(&s_fsr.b, VK_FORMAT_R8G8B8A8_UNORM, s_fsr.w, s_fsr.h, use, VK_IMAGE_ASPECT_COLOR_BIT))
+        return -1;
+    VkDescriptorSetLayoutBinding b[2];
+    memset(b, 0, sizeof b);
+    b[0].binding = 0; b[0].descriptorCount = 1; b[0].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    b[0].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    b[1].binding = 1; b[1].descriptorCount = 1; b[1].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    b[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    VkDescriptorSetLayoutCreateInfo dli = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, .bindingCount = 2, .pBindings = b };
+    VK_CHECK(pvkCreateDescriptorSetLayout(s_vk.device, &dli, NULL, &s_fsr.dsl), "vkCreateDescriptorSetLayout(fsr)");
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 64 };
+    VkPipelineLayoutCreateInfo pli = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1, .pSetLayouts = &s_fsr.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pcr };
+    VK_CHECK(pvkCreatePipelineLayout(s_vk.device, &pli, NULL, &s_fsr.pl), "vkCreatePipelineLayout(fsr)");
+    const struct { const uint32_t* code; size_t bytes; } src[2] = {
+        { rsx_vk_fsr_easu_spv, sizeof rsx_vk_fsr_easu_spv }, { rsx_vk_fsr_rcas_spv, sizeof rsx_vk_fsr_rcas_spv } };
+    for (int i = 0; i < 2; i++) {
+        if (vk_create_shader(src[i].code, src[i].bytes, &s_fsr.mod[i])) return -1;
+        VkComputePipelineCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO, .layout = s_fsr.pl,
+            .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                       .module = s_fsr.mod[i], .pName = "main" } };
+        VK_CHECK(pvkCreateComputePipelines(s_vk.device, s_pipe_cache, 1, &ci, NULL, &s_fsr.pipe[i]), "vkCreateComputePipelines(fsr)");
+    }
+    VkDescriptorPoolSize sizes[2] = { { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 2 }, { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2 } };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO, .maxSets = 2, .poolSizeCount = 2, .pPoolSizes = sizes };
+    VK_CHECK(pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_fsr.pool), "vkCreateDescriptorPool(fsr)");
+    VkDescriptorSetLayout layouts[2] = { s_fsr.dsl, s_fsr.dsl };
+    VkDescriptorSet sets[2];
+    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO, .descriptorPool = s_fsr.pool, .descriptorSetCount = 2, .pSetLayouts = layouts };
+    VK_CHECK(pvkAllocateDescriptorSets(s_vk.device, &ai, sets), "vkAllocateDescriptorSets(fsr)");
+    s_fsr.set_easu = sets[0]; s_fsr.set_rcas = sets[1];
+    VkSamplerCreateInfo sci = { .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO, .magFilter = VK_FILTER_LINEAR, .minFilter = VK_FILTER_LINEAR,
+        .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE };
+    VK_CHECK(pvkCreateSampler(s_vk.device, &sci, NULL, &s_fsr.samp), "vkCreateSampler(fsr)");
+    /* RCAS reads image A and writes B for ever; only EASU's input view changes, per presented surface. */
+    VkDescriptorImageInfo ra = { s_fsr.samp, s_fsr.a.view, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorImageInfo wa = { VK_NULL_HANDLE, s_fsr.a.view, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorImageInfo wb = { VK_NULL_HANDLE, s_fsr.b.view, VK_IMAGE_LAYOUT_GENERAL };
+    VkWriteDescriptorSet w[3];
+    memset(w, 0, sizeof w);
+    w[0] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_fsr.set_rcas, .dstBinding = 0, .descriptorCount = 1,
+                                   .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &ra };
+    w[1] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_fsr.set_rcas, .dstBinding = 1, .descriptorCount = 1,
+                                   .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &wb };
+    w[2] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_fsr.set_easu, .dstBinding = 1, .descriptorCount = 1,
+                                   .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &wa };
+    pvkUpdateDescriptorSets(s_vk.device, 3, w, 0, NULL);
+    if ((s_begin_reason = "fsr_init", vk_begin())) return -1;
+    vk_barrier_image(s_fsr.a.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(s_fsr.b.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    if ((s_submit_reason = "fsr_init", vk_submit_and_wait())) return -1;
+    s_fsr.ready = 1;
+    VK_LOG("FSR 1.0 ready (%ux%u, sharpness %.2f)\n", s_fsr.w, s_fsr.h, s_fsr.sharpness);
+    return 0;
+}
+
+/* Whether the present of an in_w x in_h surface goes through FSR. Creates the images and pipelines on first use, which
+ * submits work of its own, so call it before the present's command buffer is open. */
+static int vk_fsr_prepare(u32 in_w, u32 in_h)
+{
+    static int inited;
+    if (!inited) { vk_fsr_init(); inited = 1; }
+    if (!s_fsr.enabled || s_fsr.failed || in_w >= s_vk.width || in_h >= s_vk.height) return 0;
+    if (!s_fsr.ready && vk_fsr_create()) { VK_LOG("FSR unavailable\n"); s_fsr.failed = 1; return 0; }
+    return 1;
+}
+
+/* Records EASU and RCAS from `in_view` (in_w x in_h, GENERAL layout) into image B and returns it. Only after
+ * vk_fsr_prepare returned 1, with the command buffer open. */
+static VkImage vk_fsr_record(VkImageView in_view, u32 in_w, u32 in_h)
+{
+    VkDescriptorImageInfo in = { s_fsr.samp, in_view, VK_IMAGE_LAYOUT_GENERAL };
+    VkWriteDescriptorSet w = { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_fsr.set_easu, .dstBinding = 0, .descriptorCount = 1,
+                               .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &in };
+    pvkUpdateDescriptorSets(s_vk.device, 1, &w, 0, NULL);
+
+    /* FsrEasuCon from ffx_fsr1.h: the input is the whole resource, so viewport and size are the same. */
+    const float ix = (float)in_w, iy = (float)in_h, ox = (float)s_vk.width, oy = (float)s_vk.height;
+    uint32_t c[16];
+    c[0] = fsr_bits(ix / ox);              c[1] = fsr_bits(iy / oy);
+    c[2] = fsr_bits(0.5f * ix / ox - 0.5f); c[3] = fsr_bits(0.5f * iy / oy - 0.5f);
+    c[4] = fsr_bits(1.0f / ix);            c[5] = fsr_bits(1.0f / iy);
+    c[6] = fsr_bits(1.0f / ix);            c[7] = fsr_bits(-1.0f / iy);
+    c[8] = fsr_bits(-1.0f / ix);           c[9] = fsr_bits(2.0f / iy);
+    c[10] = fsr_bits(1.0f / ix);           c[11] = fsr_bits(2.0f / iy);
+    c[12] = fsr_bits(0.0f / ix);           c[13] = fsr_bits(4.0f / iy);
+    c[14] = c[15] = 0;
+    const u32 gx = (s_vk.width + 15) / 16, gy = (s_vk.height + 15) / 16;
+
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fsr.pipe[0]);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fsr.pl, 0, 1, &s_fsr.set_easu, 0, NULL);
+    pvkCmdPushConstants(s_vk.cmd, s_fsr.pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, 64, c);
+    pvkCmdDispatch(s_vk.cmd, gx, gy, 1);
+    ip_pass_barrier();
+
+    /* FsrRcasCon: con[0] is 2^-sharpness, con[1] the same as two halves (only the packed-half shader reads it). */
+    uint32_t r[16] = { 0 };
+    r[0] = fsr_bits(exp2f(-s_fsr.sharpness));
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fsr.pipe[1]);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fsr.pl, 0, 1, &s_fsr.set_rcas, 0, NULL);
+    pvkCmdPushConstants(s_vk.cmd, s_fsr.pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, 64, r);
+    pvkCmdDispatch(s_vk.cmd, gx, gy, 1);
+    ip_pass_barrier();
+    return s_fsr.b.img;
+}
