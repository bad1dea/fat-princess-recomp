+#version 450
+#extension GL_GOOGLE_include_directive : require
+// Refinement at 1/2-size luma: one workgroup per 8x8 block (16x16 full-size pixels). Candidates are the
+// coarse vector (doubled) + e, e in [-3, 3]^2, and the zero vector. The luma tiles around base +- e are
+// staged in shared memory; the zero vector reads the images directly.
+layout(local_size_x = 64) in;
+#include "rsx_vk_interp_common.glsl"
+const int E = 3;
+const int T = 8 + 2 * E;
+shared float tp[T * T];
+shared float tc[T * T];
+shared float sads[64];
+shared uint best;
+void main()
+{
+    ivec2 fb = (imageSize(uL2Cur) + 7) / 8;
+    ivec2 cb = (imageSize(uL4Cur) + 7) / 8;
+    ivec2 b = ivec2(gl_WorkGroupID.xy);
+    if (b.x >= fb.x || b.y >= fb.y) return;
+    if (gl_LocalInvocationIndex == 0) best = 0xFFFFFFFFu;
+    ivec2 org = b * 8;
+    ivec2 base = 2 * coarse[min(b.y / 2, cb.y - 1) * cb.x + min(b.x / 2, cb.x - 1)];
+    for (int i = int(gl_LocalInvocationIndex); i < T * T; i += 64) {
+        ivec2 t = ivec2(i % T, i / T) - E;
+        tp[i] = LUMA_AT(uL2Prev, org - base + t);
+        tc[i] = LUMA_AT(uL2Cur, org + base + t);
+    }
+    barrier();
+    int c = int(gl_LocalInvocationIndex);
+    if (c < 49) {
+        ivec2 e = ivec2(c % 7 - E, c / 7 - E);
+        float sad = 0.0;
+        for (int y = 0; y < 8; y++)
+            for (int x = 0; x < 8; x++)
+                sad += abs(tp[(y + E - e.y) * T + (x + E - e.x)] - tc[(y + E + e.y) * T + (x + E + e.x)]);
+        sads[c] = sad;
+        float cost = sad + 0.02 * float(abs(e.x) + abs(e.y)) + 0.01 * float(abs(base.x + e.x) + abs(base.y + e.y));
+        atomicMin(best, (uint(cost * 1024.0) << 6) | uint(c));
+    } else if (c == 49) {
+        float sad = 0.0;
+        for (int y = 0; y < 8; y++)
+            for (int x = 0; x < 8; x++)
+                sad += abs(LUMA_AT(uL2Prev, org + ivec2(x, y)) - LUMA_AT(uL2Cur, org + ivec2(x, y)));
+        sads[49] = sad;
+        float cost = sad + 0.02 * float(abs(base.x) + abs(base.y));
+        atomicMin(best, (uint(cost * 1024.0) << 6) | 49u);
+    }
+    barrier();
+    if (gl_LocalInvocationIndex == 0) {
+        int w = int(best & 63u);
+        ivec2 d = w < 49 ? base + ivec2(w % 7 - E, w / 7 - E) : ivec2(0);
+        FineBlock f;
+        f.dx = d.x; f.dy = d.y;
+        f.err = sads[w] / 64.0;
+        f.zero_err = sads[49] / 64.0;
+        fine[b.y * fb.x + b.x] = f;
+    }
+}
