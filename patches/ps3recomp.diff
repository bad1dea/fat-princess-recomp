+/* handler(ctxId, connId, event, errorCode, arg) for the plain handler of every context (events
+ * 0 to 3), and for the extended handler of every context (all events). */
+static void notify(u32 conn, s32 event, s32 error)
+{
+    for (u32 i = 0; i < SCE_NP_SIGNALING_CTX_MAX; i++) {
+        if (!s_ctx[i].in_use) continue;
+        if (s_ctx[i].handler && event <= SCE_NP_SIGNALING_EVENT_NETINFO_RESULT) {
+            const u64 a[8] = { i, conn, (u64)(u32)event, (u64)(u32)error, s_ctx[i].handler_arg, 0, 0, 0 };
+            cellSysutilQueueGuestCallbackArgs(s_ctx[i].handler, a);
+        }
+        if (s_ctx[i].ext_handler) {
+            const u64 a[8] = { i, conn, (u64)(u32)event, (u64)(u32)error, s_ctx[i].ext_arg, 0, 0, 0 };
+            cellSysutilQueueGuestCallbackArgs(s_ctx[i].ext_handler, a);
+        }
+    }
+}
+
+static void establish(Conn* c)
+{
+    if (c->status == SCE_NP_SIGNALING_CONN_STATUS_ACTIVE) return;
+    c->status = SCE_NP_SIGNALING_CONN_STATUS_ACTIVE;
+    np_psnr_punch(c->user, c->ip, c->port);
+    notify(c->id, SCE_NP_SIGNALING_EVENT_ESTABLISHED, 0);
+    if (c->op_activated) notify(c->id, SCE_NP_SIGNALING_EVENT_EXT_MUTUAL_ACTIVATED, 0);
