diff --git a/libs/video/vulkan/rsx_vk_output.inc b/libs/video/vulkan/rsx_vk_output.inc
new file mode 100644
index 00000000..9b8318d6
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_output.inc
@@ -0,0 +1,64 @@
+/* Host output size is independent of the guest's boot-time display buffers.
+ * Allocate replacements first so an allocation failure leaves the old output usable. */
+int rsx_vulkan_backend_set_output_size(u32 width, u32 height)
+{
+    if (!s_vk.device) return -1;
+    if (width == s_vk.width && height == s_vk.height) return 0;
+    if (!width || !height || width > s_vk.max_dim || height > s_vk.max_dim) return -1;
+    vk_image color = {0}, depth = {0};
+    vk_buffer readback = {0};
+    VkFramebuffer framebuffer = VK_NULL_HANDLE;
+    if (vk_create_image(&color, VK_FORMAT_R8G8B8A8_UNORM, width, height,
+            VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+            VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT, VK_IMAGE_ASPECT_COLOR_BIT) ||
+        vk_create_image(&depth, s_vk.depth_format, width, height,
+            VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+            s_vk.depth_aspect) ||
+        vk_create_host_buffer(&readback, (VkDeviceSize)width * height * 4u,
+            VK_BUFFER_USAGE_TRANSFER_DST_BIT)) goto fail;
+    VkImageView views[] = { color.view, depth.view };
+    VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+        .renderPass = s_vk.render_pass, .attachmentCount = 2, .pAttachments = views,
+        .width = width, .height = height, .layers = 1 };
+    if (pvkCreateFramebuffer(s_vk.device, &fci, NULL, &framebuffer) != VK_SUCCESS) goto fail;
+    if (vk_flush_at("output resize") || pvkDeviceWaitIdle(s_vk.device) != VK_SUCCESS) goto fail;
+    if ((s_begin_reason = "output resize", vk_begin())) goto fail;
+    vk_barrier_image(color.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(depth.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(s_vk.color.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit blit = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { {0, 0, 0}, {(int32_t)s_vk.width, (int32_t)s_vk.height, 1} },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { {0, 0, 0}, {(int32_t)width, (int32_t)height, 1} },
+    };
+    pvkCmdBlitImage(s_vk.cmd, s_vk.color.img, VK_IMAGE_LAYOUT_GENERAL,
+        color.img, VK_IMAGE_LAYOUT_GENERAL, 1, &blit, VK_FILTER_LINEAR);
+    VkClearDepthStencilValue far_plane = {1.0f, 0};
+    VkImageSubresourceRange dr = {s_vk.depth_aspect, 0, 1, 0, 1};
+    pvkCmdClearDepthStencilImage(s_vk.cmd, depth.img, VK_IMAGE_LAYOUT_GENERAL, &far_plane, 1, &dr);
+    if ((s_submit_reason = "output resize", vk_submit_and_wait())) goto fail;
+    vk_interp_release();
+    vk_fsr_release();
+    pvkDestroyFramebuffer(s_vk.device, s_vk.framebuffer, NULL);
+    vk_destroy_image(&s_vk.color);
+    vk_destroy_image(&s_vk.depth);
+    vk_destroy_buffer(&s_vk.readback);
+    s_vk.color = color;
+    s_vk.depth = depth;
+    s_vk.readback = readback;
+    s_vk.framebuffer = framebuffer;
+    s_vk.width = width;
+    s_vk.height = height;
+    s_vk.presented = 0;  /* No cached pixels at the new size until its first readback. */
+    if (s_vk.window) SDL_SetWindowSize(s_vk.window, (int)width, (int)height);
+    VK_LOG("live output %ux%u\n", width, height);
+    return 0;
+fail:
+    if (framebuffer) pvkDestroyFramebuffer(s_vk.device, framebuffer, NULL);
+    vk_destroy_image(&color);
+    vk_destroy_image(&depth);
+    vk_destroy_buffer(&readback);
+    VK_LOG("output resize to %ux%u failed; keeping %ux%u\n", width, height, s_vk.width, s_vk.height);
+    return -1;
+}
