diff --git a/libs/video/vulkan/rsx_vk_interp_synth.comp b/libs/video/vulkan/rsx_vk_interp_synth.comp
new file mode 100644
index 00000000..89bf0832
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_interp_synth.comp
@@ -0,0 +1,31 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+// Builds the frame at phase pc.p.x between prev and cur. Each output pixel blends the predictions of the four
+// nearest 16x16 blocks (bilinear weights); a block whose best match is poor uses no motion.
+layout(local_size_x = 16, local_size_y = 16) in;
+#include "rsx_vk_interp_common.glsl"
+void main()
+{
+    ivec2 size = imageSize(uOut);
+    ivec2 x = ivec2(gl_GlobalInvocationID.xy);
+    if (x.x >= size.x || x.y >= size.y) return;
+    float a = pc.p.x;
+    ivec2 fb = (imageSize(uL2Cur) + 7) / 8;
+    vec2 u = (vec2(x) + 0.5) / 16.0 - 0.5;
+    ivec2 b0 = ivec2(floor(u));
+    vec2 f = u - vec2(b0);
+    vec2 inv = 1.0 / vec2(size);
+    vec3 acc = vec3(0.0);
+    for (int j = 0; j < 2; j++)
+        for (int i = 0; i < 2; i++) {
+            float w = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y);
+            ivec2 b = clamp(b0 + ivec2(i, j), ivec2(0), fb - 1);
+            FineBlock fbk = fine[b.y * fb.x + b.x];
+            // d is in 1/2-size pixels and the vector spans half of prev->cur, so the whole motion is 4 d full-size pixels.
+            vec2 m = fbk.err > pc.p.y ? vec2(0.0) : 4.0 * vec2(fbk.dx, fbk.dy);
+            vec3 p = texture(uPrev, (vec2(x) + 0.5 - a * m) * inv).rgb;
+            vec3 c = texture(uCur, (vec2(x) + 0.5 + (1.0 - a) * m) * inv).rgb;
+            acc += w * mix(p, c, a);
+        }
+    imageStore(uOut, x, vec4(acc, 1.0));
+}
