diff --git a/libs/video/vulkan/rsx_vk_hud.comp b/libs/video/vulkan/rsx_vk_hud.comp
new file mode 100644
index 00000000..03c22236
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_hud.comp
@@ -0,0 +1,23 @@
+// Stats overlay blended over the window image at an opacity: T (the frame under the overlay, scaled to window pixels)
+// is read and written in place. Regenerate:
+//   glslangValidator -V --target-env vulkan1.0 --vn rsx_vk_hud_spv -o rsx_vk_hud.spv.h rsx_vk_hud.comp   (then expand -t 4)
+//   or: glslc --target-env=vulkan1.0 -mfmt=num -o - rsx_vk_hud.comp, wrapped in the same array
+#version 450
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0, rgba8) uniform image2D T;
+layout(set = 0, binding = 1, std430) readonly buffer Overlay { uint px[]; };
+layout(push_constant) uniform Params { uint w; uint h; float opacity; float radius; };
+
+void main()
+{
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x >= w || p.y >= h) return;
+    vec4 o = unpackUnorm4x8(px[p.y * w + p.x]);          // overlay bytes are R, G, B, A
+    float lum = max(o.r, max(o.g, o.b));
+    float a = lum > 0.45 ? max(opacity, 0.9) : opacity;   // the text stays readable, the panel fades
+    // rounded corners: outside the corner circle the frame shows through, with a one-pixel soft edge
+    vec2 q = max(vec2(radius) - (vec2(p) + 0.5), (vec2(p) + 0.5) - (vec2(w, h) - radius));
+    if (radius > 0.0 && q.x > 0.0 && q.y > 0.0) a *= clamp(radius + 0.5 - length(q), 0.0, 1.0);
+    vec4 under = imageLoad(T, ivec2(p));
+    imageStore(T, ivec2(p), vec4(mix(under.rgb, o.rgb, a), 1.0));
+}
diff --git a/libs/video/vulkan/rsx_vk_hud.inc b/libs/video/vulkan/rsx_vk_hud.inc
new file mode 100644
index 00000000..c41400cd
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_hud.inc
@@ -0,0 +1,106 @@
+/* The stats overlay at less than full opacity (included by rsx_vulkan_backend.c before vk_present_window_from).
+ *
+ * At full opacity the overlay is a plain buffer copy onto the window image. Below that the part of the frame under it is
+ * blitted (scaled to window pixels) into a scratch image, rsx_vk_hud.comp mixes the overlay over it, and the result is
+ * blitted back, so the frame itself, and the screenshots and frame ring taken from it, never contain the overlay.
+ */
+#include "rsx_vk_hud.spv.h"
+
+typedef struct vk_hud_state {
+    int ready, failed, layout_ok;
+    vk_image t;
+    VkDescriptorSetLayout dsl;
+    VkDescriptorPool pool;
+    VkDescriptorSet set;
+    VkPipelineLayout pl;
+    VkShaderModule mod;
+    VkPipeline pipe;
+} vk_hud_state;
+static vk_hud_state s_hud;
+static vk_buffer s_hud_rgba;            /* the overlay as R, G, B, A bytes (the copy path's buffer is in window order) */
+static float s_overlay_opacity = 1.0f;
+
+static int vk_hud_create(void)
+{
+    if (vk_create_image(&s_hud.t, VK_FORMAT_R8G8B8A8_UNORM, 1024, 512,
+                        VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                        VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+    VkDescriptorSetLayoutBinding b[2];
+    memset(b, 0, sizeof b);
+    b[0].binding = 0; b[0].descriptorCount = 1; b[0].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT; b[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    b[1].binding = 1; b[1].descriptorCount = 1; b[1].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT; b[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    VkDescriptorSetLayoutCreateInfo dli = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, .bindingCount = 2, .pBindings = b };
+    VK_CHECK(pvkCreateDescriptorSetLayout(s_vk.device, &dli, NULL, &s_hud.dsl), "vkCreateDescriptorSetLayout(hud)");
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 16 };
+    VkPipelineLayoutCreateInfo pli = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1, .pSetLayouts = &s_hud.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pcr };
+    VK_CHECK(pvkCreatePipelineLayout(s_vk.device, &pli, NULL, &s_hud.pl), "vkCreatePipelineLayout(hud)");
+    if (vk_create_shader(rsx_vk_hud_spv, sizeof rsx_vk_hud_spv, &s_hud.mod)) return -1;
+    VkComputePipelineCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO, .layout = s_hud.pl,
+        .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                   .module = s_hud.mod, .pName = "main" } };
+    VK_CHECK(pvkCreateComputePipelines(s_vk.device, s_pipe_cache, 1, &ci, NULL, &s_hud.pipe), "vkCreateComputePipelines(hud)");
+    VkDescriptorPoolSize sizes[2] = { { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1 }, { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1 } };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO, .maxSets = 1, .poolSizeCount = 2, .pPoolSizes = sizes };
+    VK_CHECK(pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_hud.pool), "vkCreateDescriptorPool(hud)");
+    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO, .descriptorPool = s_hud.pool, .descriptorSetCount = 1, .pSetLayouts = &s_hud.dsl };
+    VK_CHECK(pvkAllocateDescriptorSets(s_vk.device, &ai, &s_hud.set), "vkAllocateDescriptorSets(hud)");
+    s_hud.ready = 1;
+    return 0;
+}
+
+/* Records the blended overlay onto swapchain image `dst` (in TRANSFER_DST). `src` is the frame that was just blitted
+ * into the window rect dx, dy, dw, dh. Returns 0 when it did nothing and the caller should copy the overlay instead. */
+/* (ox, oy): the overlay's top-left corner in the window. wx/wy below are window coordinates. */
+static int vk_hud_blend(VkImage src, int32_t dx, int32_t dy, int32_t dw, int32_t dh, u32 w, u32 h, VkImage dst,
+                        int32_t ox, int32_t oy)
+{
+    if (s_overlay_opacity >= 0.99f || !s_hud_rgba.buf || s_hud.failed || w > 1024 || h > 512 || dw <= 0 || dh <= 0) return 0;
+    if (!s_hud.ready && vk_hud_create()) { s_hud.failed = 1; return 0; }
+    const int32_t wx0 = dx > ox ? dx : ox, wy0 = dy > oy ? dy : oy;
+    const int32_t wx1 = ox + (int32_t)w < dx + dw ? ox + (int32_t)w : dx + dw, wy1 = oy + (int32_t)h < dy + dh ? oy + (int32_t)h : dy + dh;
+    if (wx1 <= wx0 || wy1 <= wy0) return 0;
+
+    VkDescriptorImageInfo ti = { VK_NULL_HANDLE, s_hud.t.view, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorBufferInfo bi = { s_hud_rgba.buf, 0, VK_WHOLE_SIZE };
+    VkWriteDescriptorSet wr[2];
+    memset(wr, 0, sizeof wr);
+    wr[0] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_hud.set, .dstBinding = 0, .descriptorCount = 1,
+                                    .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &ti };
+    wr[1] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_hud.set, .dstBinding = 1, .descriptorCount = 1,
+                                    .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &bi };
+    pvkUpdateDescriptorSets(s_vk.device, 2, wr, 0, NULL);
+
+    if (!s_hud.layout_ok) { vk_barrier_image(s_hud.t.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED); s_hud.layout_ok = 1; }
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT };
+    if (wx0 > ox || wy0 > oy || wx1 < ox + (int32_t)w || wy1 < oy + (int32_t)h) {      /* letterbox bars under part of the overlay */
+        VkClearColorValue black = { .float32 = { 0.f, 0.f, 0.f, 1.f } };
+        VkImageSubresourceRange all = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        pvkCmdClearColorImage(s_vk.cmd, s_hud.t.img, VK_IMAGE_LAYOUT_GENERAL, &black, 1, &all);
+        pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+    }
+    VkImageBlit under = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { (int32_t)((int64_t)(wx0 - dx) * (int32_t)s_vk.width / dw), (int32_t)((int64_t)(wy0 - dy) * (int32_t)s_vk.height / dh), 0 },
+                        { (int32_t)((int64_t)(wx1 - dx) * (int32_t)s_vk.width / dw), (int32_t)((int64_t)(wy1 - dy) * (int32_t)s_vk.height / dh), 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { wx0 - ox, wy0 - oy, 0 }, { wx1 - ox, wy1 - oy, 1 } } };
+    pvkCmdBlitImage(s_vk.cmd, src, VK_IMAGE_LAYOUT_GENERAL, s_hud.t.img, VK_IMAGE_LAYOUT_GENERAL, 1, &under, VK_FILTER_LINEAR);
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+
+    struct { uint32_t w, h; float opacity, radius; } pc = { w, h, s_overlay_opacity, (float)s_debug_radius };
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_hud.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_hud.pl, 0, 1, &s_hud.set, 0, NULL);
+    pvkCmdPushConstants(s_vk.cmd, s_hud.pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, &pc);
+    pvkCmdDispatch(s_vk.cmd, (w + 7) / 8, (h + 7) / 8, 1);
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+
+    VkImageBlit back = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .srcOffsets = { { 0, 0, 0 }, { (int32_t)w, (int32_t)h, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .dstOffsets = { { ox, oy, 0 }, { ox + (int32_t)w, oy + (int32_t)h, 1 } } };
+    pvkCmdBlitImage(s_vk.cmd, s_hud.t.img, VK_IMAGE_LAYOUT_GENERAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &back, VK_FILTER_NEAREST);
+    return 1;
+}
+
