+/* Matching2 told us a room member is reachable (up) or gone (!up). */
+void np_signaling_peer_event(const char* online_id, const u8 ip[4], u16 port, u32 user, int up, int is_owner)
+{
+    if (!s_initialized) return;
+    Conn* c = conn_by_name(online_id);
+    if (up) {
+        if (!c) c = conn_new(online_id);
+        if (!c) return;
+        memcpy(c->ip, ip, 4); c->port = port; c->user = user;
+        if (is_owner && !c->op_activated) {
+            c->op_activated = 1;   /* the joiner reaches us first: it counts as having activated */
+            if (c->status != SCE_NP_SIGNALING_CONN_STATUS_ACTIVE) notify(c->id, SCE_NP_SIGNALING_EVENT_EXT_PEER_ACTIVATED, 0);
+            else notify(c->id, SCE_NP_SIGNALING_EVENT_EXT_MUTUAL_ACTIVATED, 0);
+        }
+        if (c->activated && c->status != SCE_NP_SIGNALING_CONN_STATUS_ACTIVE) establish(c);
+    } else if (c) {
+        int was = c->status;
+        c->status = SCE_NP_SIGNALING_CONN_STATUS_INACTIVE;
+        if (c->op_activated) { c->op_activated = 0; notify(c->id, SCE_NP_SIGNALING_EVENT_EXT_PEER_DEACTIVATED, 0); }
+        if (was != SCE_NP_SIGNALING_CONN_STATUS_INACTIVE) notify(c->id, SCE_NP_SIGNALING_EVENT_DEAD, 0);
+    }
+}
