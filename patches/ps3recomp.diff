+    int ok; const u128 r = spu__x_native_fix(_mm_castps_si128(_mm_mul_ps(_mm_castsi128_ps(x), _mm_castsi128_ps(y))), &ok);
+    if (__builtin_expect(ok, 1)) return r;
+    return spu__x_fm_slow(a, b);
