+    memset(out, 0, sizeof *out);
+    if (!ensure_connected()) return -1;
+    psnr_msg m;
+    if (np_psnr_call(PSNR_GET_FRIEND_LIST, NULL, 0, &m, 1500) != 1) return -1;
+    int ret = -1;
+    if (m.type == PSNR_ERROR && m.len >= 4) ret = (int)psnr_get32(m.data);
+    else if (m.type == PSNR_FRIEND_LIST && m.len >= 2) {
+        const uint8_t* p = m.data;
+        const uint8_t* end = m.data + m.len;
+        uint32_t n = psnr_get16(p);
