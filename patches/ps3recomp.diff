+#define VC_BUDGET (384ull << 20)        /* stored conversions */
+#define VC_MIN_REFS 24u
+typedef struct {
+    u64 key, src;
+    u32 last_frame, first, last;
+    u32 n_source, n_unique, n_cuts, stride;
+    int remapped;
+    u8* verts; u32* remap; u32* cuts;
+    u32* indices; u32 prim, n_draw;   /* the rebuilt index list, filled by the first draw that uses the entry */
+    u64 bytes;
+    u8 verts_pooled, indices_pooled;  /* from the backend's persistent pool (bound without a copy) */
+    u32 stable, verified_frame;       /* consecutive frames the source bytes matched; frame of the last check */
+    u32 changes, skip_until;          /* source changed on consecutive checks: not stored or hashed until skip_until */
