diff --git a/libs/input/tests/test_menu_keyboard_sdl.c b/libs/input/tests/test_menu_keyboard_sdl.c
new file mode 100644
index 00000000..c89c6ed3
--- /dev/null
+++ b/libs/input/tests/test_menu_keyboard_sdl.c
@@ -0,0 +1,37 @@
+#include <assert.h>
+#include <stdio.h>
+#include <SDL2/SDL.h>
+#ifndef PAD_SOURCE_FILE
+#define PAD_SOURCE_FILE "../cellPad.c"
+#endif
+#include PAD_SOURCE_FILE
+static SDL_Joystick* attach(const char* name, int product) {
+    SDL_VirtualJoystickDesc d={0};d.version=SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    d.type=SDL_JOYSTICK_TYPE_GAMECONTROLLER;d.naxes=SDL_CONTROLLER_AXIS_MAX;
+    d.nbuttons=SDL_CONTROLLER_BUTTON_MAX;d.vendor_id=0x1234;d.product_id=product;d.name=name;
+    int index=SDL_JoystickAttachVirtualEx(&d);assert(index>=0);
+    SDL_Joystick* pad=SDL_JoystickOpen(index);assert(pad);
+    char guid[33],mapping[512];SDL_JoystickGetGUIDString(SDL_JoystickGetGUID(pad),guid,sizeof guid);
+    snprintf(mapping,sizeof mapping,"%s,%s,a:b0,b:b1,x:b2,y:b3,back:b4,start:b6,leftshoulder:b9,rightshoulder:b10,dpup:b11,dpdown:b12,dpleft:b13,dpright:b14,leftx:a0,lefty:a1,",guid,name);
+    assert(SDL_GameControllerAddMapping(mapping)>=0);return pad;
+}
+static void poll(void) { SDL_Delay(5);pad_poll_backend(); }
+int main(void) {
+    assert(SDL_Init(SDL_INIT_GAMECONTROLLER|SDL_INIT_EVENTS)==0);
+    SDL_Joystick* keyboard=attach("Fat Princess Keyboard",1);
+    SDL_JoystickSetVirtualButton(keyboard,SDL_CONTROLLER_BUTTON_DPAD_DOWN,1);poll();
+    assert(s_host_state[0].buttons & CELL_PAD_CTRL_DOWN);
+    assert(fp_pad_host_buttons()==0);
+    SDL_Joystick* controller=attach("Menu Test Pad",2);
+    SDL_JoystickSetVirtualButton(controller,SDL_CONTROLLER_BUTTON_A,1);
+    SDL_JoystickSetVirtualAxis(controller,SDL_CONTROLLER_AXIS_LEFTX,-32767);poll();
+    assert(fp_pad_host_buttons()==(CELL_PAD_CTRL_CROSS|CELL_PAD_CTRL_LEFT));
+    assert(s_host_state[0].buttons & CELL_PAD_CTRL_DOWN);
+    SDL_JoystickSetVirtualButton(controller,SDL_CONTROLLER_BUTTON_A,0);
+    SDL_JoystickSetVirtualAxis(controller,SDL_CONTROLLER_AXIS_LEFTX,0);poll();
+    assert(fp_pad_host_buttons()==0);
+    SDL_JoystickClose(controller);assert(SDL_JoystickDetachVirtual(1)==0);poll();
+    assert(fp_pad_host_buttons()==0 && (s_host_state[0].buttons & CELL_PAD_CTRL_DOWN));
+    puts("SDL menu: virtual keyboard excluded, real controller/axis/release/hotplug preserved");
+    return 0;
+}
diff --git a/libs/input/tests/test_menu_keyboard_win.c b/libs/input/tests/test_menu_keyboard_win.c
new file mode 100644
index 00000000..b525a708
--- /dev/null
+++ b/libs/input/tests/test_menu_keyboard_win.c
@@ -0,0 +1,64 @@
+/* The Windows keyboard fallback must still drive the game, but never also
+ * appear as a second controller press in the host menu. */
+#include <windows.h>
+#include <xinput.h>
+#include <assert.h>
+#include <stdio.h>
+static int key_down, controller;
+static int enter_down, alt_down;
+static WORD controller_buttons;
+static ULONGLONG clock_ms = 100;
+static SHORT test_key(int vk) {
+    return ((vk == VK_DOWN && key_down) || (vk == VK_RETURN && enter_down) ||
+            (vk == VK_MENU && alt_down)) ? (SHORT)0x8000 : 0;
+}
+static HWND test_foreground(void) { return (HWND)1; }
+static DWORD test_window_pid(HWND w, LPDWORD pid) { (void)w;*pid=GetCurrentProcessId();return 1; }
+static ULONGLONG test_clock(void) { return clock_ms; }
+static DWORD test_xinput(DWORD index, XINPUT_STATE* state) {
+    if (index || !controller) return ERROR_DEVICE_NOT_CONNECTED;
+    ZeroMemory(state,sizeof(*state));state->Gamepad.wButtons=controller_buttons;
+    return ERROR_SUCCESS;
+}
+#define GetAsyncKeyState test_key
+#define GetForegroundWindow test_foreground
+#define GetWindowThreadProcessId test_window_pid
+#define GetTickCount64 test_clock
+#define XInputGetState test_xinput
+#ifndef PAD_SOURCE_FILE
+#define PAD_SOURCE_FILE "../cellPad.c"
+#endif
+#include PAD_SOURCE_FILE
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo,g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a,uint64_t v,int w) { (void)a;(void)v;(void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a;return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+static void poll(void) { clock_ms+=5;pad_poll_backend(); }
+int main(void) {
+    key_down=1;poll();
+    assert(s_host_state[0].buttons & CELL_PAD_CTRL_DOWN);
+    assert(fp_pad_host_buttons()==0);
+    for (int n=0;n<40;n++) { poll();assert(fp_pad_host_buttons()==0); }
+    controller=1;controller_buttons=XINPUT_GAMEPAD_A;poll();
+    assert(fp_pad_host_buttons()==CELL_PAD_CTRL_CROSS);
+    assert(s_host_state[0].buttons==CELL_PAD_CTRL_CROSS);
+    controller_buttons=0;poll();assert(fp_pad_host_buttons()==0);
+    controller=0;poll();assert(fp_pad_host_buttons()==0);
+    assert(s_host_state[0].buttons & CELL_PAD_CTRL_DOWN);
+    key_down=0;poll();assert(fp_pad_host_buttons()==0 && !s_host_state[0].buttons);
+    s_pad_file_mask=CELL_PAD_CTRL_RIGHT;assert(fp_pad_host_buttons()==CELL_PAD_CTRL_RIGHT);
+    s_pad_file_mask=0;
+    enter_down=1;poll();assert(s_host_state[0].buttons & CELL_PAD_CTRL_START);
+    enter_down=0;poll();
+    alt_down=1;enter_down=1;poll();assert(!(s_host_state[0].buttons & CELL_PAD_CTRL_START));
+    for(int n=0;n<20;++n) { poll();assert(!(s_host_state[0].buttons & CELL_PAD_CTRL_START)); }
+    alt_down=0;poll();assert(!(s_host_state[0].buttons & CELL_PAD_CTRL_START));
+    enter_down=0;poll();enter_down=1;poll();assert(s_host_state[0].buttons & CELL_PAD_CTRL_START);
+    puts("Windows menu: keyboard fallback excluded, real controller/release/hotplug and scripted input preserved");
+    return 0;
+}
