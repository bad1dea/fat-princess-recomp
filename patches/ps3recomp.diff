diff --git a/libs/network/tests/test_trophy_set.c b/libs/network/tests/test_trophy_set.c
new file mode 100644
index 00000000..ab8bb13a
--- /dev/null
+++ b/libs/network/tests/test_trophy_set.c
@@ -0,0 +1,130 @@
+/* cc -std=gnu17 -I include libs/network/tests/test_trophy_set.c
+ * -o /tmp/test_trophy_set
+ *
+ * Builds a TROPHY.TRP holding TROP.SFM in a temporary PS3_HDD0_ROOT and checks that the
+ * context takes its trophy count and names from it, that the unlock hook fires once per
+ * fresh unlock, and that the saved JSON replaces the old file without leaving a .tmp.
+ * Optional argument: a real TROPHY.TRP, whose count and first name are printed.
+ */
+#include "../sceNpTrophy.c"
+#include <assert.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+s32 cellSysutilQueueGuestCallbackArgs(u32 func, const u64 args[8]) { (void)func; (void)args; return CELL_OK; }
+static void callback(u32 opd, u64 context, u64 status, u64 completed, u64 total,
+                     u64 arg, u64 a, u64 b, u64 c)
+{
+    (void)opd; (void)context; (void)status; (void)completed; (void)total; (void)arg; (void)a; (void)b; (void)c;
+}
+
+static int hook_calls, hook_id, hook_grade;
+static unsigned hook_icon;
+static char hook_name[128];
+static void hook(int id, const char* name, int grade, const unsigned char* png, unsigned png_size)
+{
+    hook_calls++; hook_id = id; hook_grade = grade;
+    hook_icon = png && png_size == 4 && !memcmp(png, "\x89PNG", 4) ? png_size : 0;
+    snprintf(hook_name, sizeof hook_name, "%s", name);
+}
+
+static void put32(u8* p, u32 v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+static void put64(u8* p, u64 v) { put32(p, (u32)(v >> 32)); put32(p + 4, (u32)v); }
+
+static void write_trp(const char* path, const char* sfm)
+{
+    u8 h[0x40 + 2 * 0x40] = {0};
+    put32(h, 0xDCA24D00); put32(h + 4, 1); put32(h + 0x10, 2); put32(h + 0x14, 0x40);
+    strcpy((char*)h + 0x40, "TROP.SFM");
+    put64(h + 0x40 + 32, sizeof h); put64(h + 0x40 + 40, strlen(sfm));
+    strcpy((char*)h + 0x80, "TROP001.PNG");                 /* a stand-in: only the signature */
+    put64(h + 0x80 + 32, sizeof h + strlen(sfm)); put64(h + 0x80 + 40, 4);
+    FILE* f = fopen(path, "wb"); assert(f);
+    fwrite(h, 1, sizeof h, f); fwrite(sfm, 1, strlen(sfm), f); fwrite("\x89PNG", 1, 4, f); fclose(f);
+}
+
+int main(int argc, char** argv)
+{
+    char root[] = "/tmp/ps3recomp-trophyset-XXXXXX", dir[512], path[600];
+    assert(mkdtemp(root));
+    snprintf(dir, sizeof dir, "%s/game", root); mkdir(dir, 0755);
+    snprintf(dir, sizeof dir, "%s/game/NPXX00000", root); mkdir(dir, 0755);
+    snprintf(dir, sizeof dir, "%s/game/NPXX00000/TROPDIR", root); mkdir(dir, 0755);
+    snprintf(dir, sizeof dir, "%s/game/NPXX00000/TROPDIR/NPWR00000_00", root); mkdir(dir, 0755);
+    snprintf(path, sizeof path, "%s/TROPHY.TRP", dir);
+    write_trp(path, "<trophyconf version=\"1.0\">\n"
+                    " <trophy id=\"000\" hidden=\"no\" ttype=\"B\" pid=\"-1\">\n"
+                    "  <name>Got wood?</name>\n  <detail>first</detail>\n </trophy>\n"
+                    " <trophy id=\"001\" hidden=\"no\" ttype=\"G\" pid=\"-1\">\n"
+                    "  <name>Fish &amp; Chips&apos;</name>\n  <detail>second</detail>\n </trophy>\n"
+                    " <trophy id=\"002\" hidden=\"yes\" ttype=\"S\" pid=\"-1\">\n"
+                    "  <name>Last</name>\n </trophy>\n</trophyconf>\n");
+    setenv("PS3_HDD0_ROOT", root, 1);
+    setenv("PS3_BOOT_PATH", "/dev_hdd0/game/NPXX00000/USRDIR/EBOOT.BIN", 1);
+
+    vm_base = calloc(1, 65536); assert(vm_base);
+    snprintf((char*)vm_base + 0x400, 256, "%s/saved", root);
+    sceNpTrophySetStoragePath((void*)0x400);
+    memcpy(vm_base + 0x100, "NPWR00000", 10);
+    g_ps3_guest_caller = callback;
+    sceNpTrophySetUnlockHook(hook);
+    assert(sceNpTrophyInit(NULL, 0, 0, 0) == CELL_OK);
+    assert(sceNpTrophyCreateContext((void*)0x200, (void*)0x100, NULL, 0) == CELL_OK);
+    assert(sceNpTrophyCreateHandle((void*)0x204) == CELL_OK);
+    assert(sceNpTrophyRegisterContext(1, 1, 0x300, 0, 0) == CELL_OK);
+    assert(s_contexts[1].total_trophies == 3);
+    assert(!strcmp(s_contexts[1].name[1], "Fish & Chips'"));
+    assert(s_contexts[1].grade[1] == SCE_NP_TROPHY_GRADE_GOLD);
+
+    assert(sceNpTrophyUnlockTrophy(1, 1, 3, NULL) == SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT);
+    assert(sceNpTrophyUnlockTrophy(1, 1, 1, NULL) == CELL_OK);
+    assert(hook_calls == 1 && hook_id == 1 && hook_grade == SCE_NP_TROPHY_GRADE_GOLD && hook_icon == 4);
+    assert(!strcmp(hook_name, "Fish & Chips'"));
+    assert(sceNpTrophyUnlockTrophy(1, 1, 1, NULL) == SCE_NP_TROPHY_ERROR_ALREADY_UNLOCKED);
+    assert(hook_calls == 1);
+
+    u32 count = 0;
+    assert(sceNpTrophyGetTrophyUnlockState(1, 1, (void*)0x1000, (void*)0x1100) == CELL_OK);
+    assert(vm_read32(0x1100) == 3 && vm_read32(0x1000) == 2u);
+    (void)count;
+
+    char json[700], tmp[720];
+    snprintf(json, sizeof json, "%s/saved/NPWR00000.json", root);
+    snprintf(tmp, sizeof tmp, "%s.tmp", json);
+    assert(access(json, F_OK) == 0 && access(tmp, F_OK) != 0);
+    assert(sceNpTrophyTerm() == CELL_OK);
+
+    /* A second run loads the unlock and does not report it again. */
+    hook_calls = 0;
+    assert(sceNpTrophyInit(NULL, 0, 0, 0) == CELL_OK);
+    assert(sceNpTrophyCreateContext((void*)0x200, (void*)0x100, NULL, 0) == CELL_OK);
+    assert(sceNpTrophyCreateHandle((void*)0x204) == CELL_OK);
+    assert(sceNpTrophyRegisterContext(1, 1, 0x300, 0, 0) == CELL_OK);
+    assert(s_contexts[1].unlocked[1] && hook_calls == 0);
+    assert(sceNpTrophyTerm() == CELL_OK);
+
+    if (argc > 1) {
+        snprintf(dir, sizeof dir, "%s/game/NPXX00000/TROPDIR/NPWR00737_00", root); mkdir(dir, 0755);
+        snprintf(path, sizeof path, "cp '%s' '%s/TROPHY.TRP'", argv[1], dir);
+        assert(system(path) == 0);
+        memcpy(vm_base + 0x100, "NPWR00737", 10);
+        assert(sceNpTrophyInit(NULL, 0, 0, 0) == CELL_OK);
+        assert(sceNpTrophyCreateContext((void*)0x200, (void*)0x100, NULL, 0) == CELL_OK);
+        printf("real set: %u trophies, #0 \"%s\", #26 \"%s\"\n", s_contexts[1].total_trophies,
+               s_contexts[1].name[0] ? s_contexts[1].name[0] : "?",
+               s_contexts[1].name[26] ? s_contexts[1].name[26] : "?");
+        assert(sceNpTrophyTerm() == CELL_OK);
+    }
+    snprintf(path, sizeof path, "rm -rf '%s'", root);
+    assert(system(path) == 0);
+    free(vm_base);
+    puts("Trophy set loads from TROPHY.TRP, unlocks report once and save atomically");
+}
