+static __attribute__((noinline, cold)) u128 spu__x_fm_slow(u128 a, u128 b) { return spu__x_fm(a, b); }
+static __attribute__((noinline, cold)) u128 spu__x_fma_slow(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) { return spu__x_fma(a, b, c, negp, negc); }
+SPU__X_INLINE u128 spu__n_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__x_ld(a), y = _mm_xor_si128(spu__x_ld(b), _mm_set1_epi32((int)negb));
+    int ok; const u128 r = spu__x_native_fix(_mm_castps_si128(_mm_add_ps(_mm_castsi128_ps(x), _mm_castsi128_ps(y))), &ok);
