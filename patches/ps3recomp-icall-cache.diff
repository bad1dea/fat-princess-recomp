+/* A direct-mapped cache in front of the address hash: indirect calls hit a small set of targets (vtable slots, callbacks), and the
+ * hash probe walks two large arrays. One entry is one 64-bit word (guest address, function as an offset from an anchor inside the
+ * image), so concurrent threads read and write it atomically. */
+static ppu_fn ppu_lookup_cached(uint32_t a)
+{
+    static const char anchor = 0;
+    const uint32_t slot = (a >> 2) & 4095u;
+    const uint64_t e = __atomic_load_n(&s_icall_cache[slot], __ATOMIC_RELAXED);
+    if ((uint32_t)(e >> 32) == a && a) return (ppu_fn)((const char*)&anchor + (int64_t)(int32_t)(uint32_t)e);
+    ppu_fn fn = ppu_lookup(a);
+    if (fn) {
+        const int64_t off = (const char*)fn - &anchor;
+        if (off >= INT32_MIN && off <= INT32_MAX)
+            __atomic_store_n(&s_icall_cache[slot], ((uint64_t)a << 32) | (uint32_t)(int32_t)off, __ATOMIC_RELAXED);
+    }
+    return fn;
+}
