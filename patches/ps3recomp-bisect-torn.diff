+/* RSX_BISECT 65536 (diagnostic): the guest's own threads can write a texture while it is being read. Hash the bytes
+ * before and after the copy and decode again when they changed underneath it (up to three tries). */
+static u32 eng_texture_upload(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                              u32 levels, u32 pitch, int cube, u32 remap)
+{
+    static int verify = -1;
+    if (verify < 0) { const char* e = getenv("RSX_BISECT"); verify = e && (atoi(e) & 65536); }
+    if (!verify) return eng_texture_upload_once(location, offset, fmt, w, h, levels, pitch, cube, remap);
+    const u32 span = eng_texture_span(fmt, w, h, levels, pitch, cube);
+    u32 handle = 0;
+    for (int attempt = 0; attempt < 3; attempt++) {
+        int readable = 0, readable2 = 0;
+        const u64 before = eng_texture_content_hash(location, offset, span, &readable);
+        handle = eng_texture_upload_once(location, offset, fmt, w, h, levels, pitch, cube, remap);
+        if (!handle || !readable) return handle;
+        const u64 after = eng_texture_content_hash(location, offset, span, &readable2);
+        if (after == before) return handle;
+        static unsigned torn;
+        if (++torn <= 20 || (torn % 100) == 0) fprintf(stderr, "[tex-torn] %u texture 0x%x+0x%x %ux%u changed during upload (try %d)\n", torn, location, offset, w, h, attempt + 1);
+        if (attempt < 2) { g.be->texture_release(g.be->user, handle); handle = 0; }
+    }
+    return handle;
+}
 
