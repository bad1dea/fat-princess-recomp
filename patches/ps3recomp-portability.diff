diff --git a/CMakeLists.txt b/CMakeLists.txt
index 328da532..137caad2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,9 +50,7 @@ list(FILTER HLE_SOURCES EXCLUDE REGEX "/tests/")
 option(PS3RECOMP_RSX_VULKAN "Build the Vulkan RSX backend (Linux)" OFF)
 list(FILTER HLE_SOURCES EXCLUDE REGEX "rsx_vulkan_backend\\.c$")
 if(PS3RECOMP_RSX_VULKAN)
-    if(APPLE)
-        message(FATAL_ERROR "PS3RECOMP_RSX_VULKAN is not available on macOS")
-    endif()
+    # Apple: Vulkan through MoltenVK (the backend enables the portability extensions).
     find_path(PS3RECOMP_VULKAN_INCLUDE_DIR vulkan/vulkan.h)
     if(NOT PS3RECOMP_VULKAN_INCLUDE_DIR)
         message(FATAL_ERROR "Vulkan headers not found. Debian/Ubuntu: "
@@ -66,7 +64,7 @@ endif()
 
 # The Metal backend is Objective-C and Apple-only, so it is added explicitly
 # rather than globbed. It needs no platform #ifdef of its own as a result.
-if(APPLE)
+if(APPLE AND NOT IOS)   # the Metal backend uses AppKit; iOS takes the Vulkan path
     enable_language(OBJC)
     list(APPEND HLE_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_metal_backend.m")
 endif()
@@ -163,7 +161,7 @@ else()
     target_link_libraries(ps3recomp_runtime PRIVATE Threads::Threads)
 endif()
 
-if(APPLE)
+if(APPLE AND NOT IOS)
     target_link_libraries(ps3recomp_runtime PUBLIC
         "-framework Metal"
         "-framework QuartzCore"
diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 7da54660..2688f25d 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -240,7 +240,7 @@ static int audio_backend_init(void)
     setenv("PULSE_LATENCY_MSEC", "6", 0);
 #endif
     int buf_pinned = 0;
-    if (const char* e = getenv("FP_AUDIO_BUF_BLOCKS")) { int v = atoi(e); if (v >= 1 && v <= 16) { buf_blocks = v; buf_pinned = 1; } }
+    { const char* e = getenv("FP_AUDIO_BUF_BLOCKS"); if (e) { int v = atoi(e); if (v >= 1 && v <= 16) { buf_blocks = v; buf_pinned = 1; } } }
     want.samples  = CELL_AUDIO_BLOCK_SAMPLES * buf_blocks;
     want.callback = NULL; /* push mode: SDL_QueueAudio */
 #ifndef _WIN32
@@ -1154,7 +1154,12 @@ static void* audio_mix_thread_func(void* arg)
         if (due < last_mix + 3000000ll) due = last_mix + 3000000ll;   /* never two blocks within 3 ms */
         if (now < due) {
             struct timespec w; w.tv_sec = due / 1000000000ll; w.tv_nsec = due % 1000000000ll;
+#ifdef __APPLE__
+            /* No clock_nanosleep on Apple: sleep the remaining time to the same deadline. */
+            (void)w; { long long r = due - now; struct timespec rel = { (time_t)(r / 1000000000ll), (long)(r % 1000000000ll) }; nanosleep(&rel, NULL); }
+#else
             clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &w, NULL);
+#endif
             continue;
         }
         last_mix = now;
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index f78742c2..fa913c88 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -258,6 +258,12 @@ static int vk_load_library(void)
 {
 #ifdef _WIN32
     static const char* names[] = { "vulkan-1.dll" };
+#elif defined(__APPLE__)
+    /* The Vulkan loader if installed, else MoltenVK directly (bundled in the app on iOS). */
+    static const char* names[] = { "libvulkan.1.dylib", "libvulkan.dylib", "libMoltenVK.dylib",
+                                   "@executable_path/Frameworks/MoltenVK.framework/MoltenVK",
+                                   "@executable_path/Frameworks/libMoltenVK.dylib",
+                                   "@executable_path/../Frameworks/libMoltenVK.dylib" };
 #else
     static const char* names[] = { "libvulkan.so.1", "libvulkan.so" };
 #endif
@@ -4342,6 +4348,17 @@ static int vk_init_all(u32 width, u32 height, const char* title)
         ci.enabledExtensionCount   = s_vk.inst_ext_count;
         ci.ppEnabledExtensionNames = s_vk.inst_exts;
     }
+#ifdef __APPLE__
+    /* MoltenVK is a portability implementation: the loader only lists it when asked. */
+    static const char* apple_exts[18];
+    if (s_vk.windowed) {
+        u32 n = 0;
+        for (; n < s_vk.inst_ext_count && n < 16; n++) apple_exts[n] = s_vk.inst_exts[n];
+        apple_exts[n++] = "VK_KHR_portability_enumeration";
+        ci.enabledExtensionCount = n; ci.ppEnabledExtensionNames = apple_exts;
+        ci.flags |= 0x00000001; /* VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR */
+    }
+#endif
     static const char* const validation_layer[] = { "VK_LAYER_KHRONOS_validation" };
     const char* ext_all[18];
     int validation = 0;
@@ -4405,7 +4422,12 @@ static int vk_init_all(u32 width, u32 height, const char* title)
     VkDeviceQueueCreateInfo qci = { .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
                                     .queueFamilyIndex = s_vk.queue_family,
                                     .queueCount = 1, .pQueuePriorities = &prio };
+#ifdef __APPLE__
+    /* A portability device must enable VK_KHR_portability_subset. */
+    static const char* dev_exts[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME, "VK_KHR_portability_subset" };
+#else
     static const char* dev_exts[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+#endif
     /* DXT (BC1-3) is how PS3 titles ship most textures; Vulkan gates it
      * behind a feature, enabled only when the device reports it. */
     VkPhysicalDeviceFeatures have, want;
@@ -4428,7 +4450,7 @@ static int vk_init_all(u32 width, u32 height, const char* title)
     }
     VkDeviceCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
                                .queueCreateInfoCount = 1, .pQueueCreateInfos = &qci,
-                               .enabledExtensionCount = s_vk.windowed ? 1u : 0u,
+                               .enabledExtensionCount = s_vk.windowed ? (u32)(sizeof dev_exts / sizeof dev_exts[0]) : 0u,
                                .ppEnabledExtensionNames = s_vk.windowed ? dev_exts : NULL,
                                .pEnabledFeatures = &want };
     VK_CHECK(pvkCreateDevice(s_vk.phys, &dci, NULL, &s_vk.device), "vkCreateDevice");
diff --git a/runtime/platform/win32_compat.c b/runtime/platform/win32_compat.c
index 11a74804..2bc6b0c4 100644
--- a/runtime/platform/win32_compat.c
+++ b/runtime/platform/win32_compat.c
@@ -49,7 +49,10 @@
  * while all that is wanted here is the ucontext_t a signal handler is given. */
 #  include <sys/ucontext.h>
 #  include <mach/mach.h>
-#  include <mach/mach_vm.h>
+#  include <TargetConditionals.h>
+#  if !TARGET_OS_IOS   /* mach_vm.h is not available to iOS apps; vm_region_64 is */
+#    include <mach/mach_vm.h>
+#  endif
 #  include <mach/thread_act.h>
 #  include <pthread/qos.h>
 #else
@@ -1547,13 +1550,23 @@ static int os_region(uintptr_t addr, uintptr_t* base, size_t* size, int* prot,
     /* mach_vm_region searches UPWARDS from the address it is given and reports
      * where it landed, so one call answers both questions: a base above the
      * address means nothing is mapped at it, and that base is the gap's end. */
+#  if TARGET_OS_IOS
+    vm_address_t a = (vm_address_t)addr;
+    vm_size_t    sz = 0;
+#  else
     mach_vm_address_t a = (mach_vm_address_t)addr;
     mach_vm_size_t    sz = 0;
+#  endif
     vm_region_basic_info_data_64_t info;
     mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
     mach_port_t name = MACH_PORT_NULL;
+#  if TARGET_OS_IOS
+    kern_return_t kr = vm_region_64(mach_task_self(), &a, &sz, VM_REGION_BASIC_INFO_64,
+                                    (vm_region_info_t)&info, &cnt, &name);
+#  else
     kern_return_t kr = mach_vm_region(mach_task_self(), &a, &sz, VM_REGION_BASIC_INFO_64,
                                       (vm_region_info_t)&info, &cnt, &name);
+#  endif
     if (name != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), name);
     if (kr != KERN_SUCCESS) return 0;             /* nothing at or above it */
     if ((uintptr_t)a > addr) { *next = (uintptr_t)a; return 0; }
