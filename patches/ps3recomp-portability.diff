+        for (int i = 0; i < 6; i++) bits |= (u64)b[2 + i] << (8 * i);
+        for (int i = 0; i < 16; i++) alpha[i] = a[(bits >> (3 * i)) & 7];
+        color = b + 8;
+    }
+    u8 pal[4][4];
+    vk_bc_colors(color, pal, kind == 1);
+    const u32 idx = color[4] | (color[5] << 8) | (color[6] << 16) | ((u32)color[7] << 24);
+    for (int i = 0; i < 16; i++) {
+        u8* px = out + (size_t)(i / 4) * pitch + (size_t)(i % 4) * 4;
+        memcpy(px, pal[(idx >> (2 * i)) & 3], 4);
+        if (kind != 1) px[3] = alpha[i];
+    }
+}
