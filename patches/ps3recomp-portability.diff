+/* Devices without textureCompressionBC (Apple's iOS GPUs) get BC1..3 decoded
+ * here into RGBA8, the same texels a BC image would sample. */
+static void vk_bc_colors(const u8* b, u8 pal[4][4], int bc1)
+{
+    const u32 c0 = b[0] | (b[1] << 8), c1 = b[2] | (b[3] << 8);
+    const u32 cs[2] = { c0, c1 };
+    for (int i = 0; i < 2; i++) {
+        const u32 r = (cs[i] >> 11) & 31, g = (cs[i] >> 5) & 63, bl = cs[i] & 31;
+        pal[i][0] = (u8)((r << 3) | (r >> 2)); pal[i][1] = (u8)((g << 2) | (g >> 4));
+        pal[i][2] = (u8)((bl << 3) | (bl >> 2)); pal[i][3] = 255;
+    }
+    for (int k = 0; k < 3; k++) {
+        if (!bc1 || c0 > c1) {
+            pal[2][k] = (u8)((2 * pal[0][k] + pal[1][k]) / 3);
+            pal[3][k] = (u8)((pal[0][k] + 2 * pal[1][k]) / 3);
+        } else {
+            pal[2][k] = (u8)((pal[0][k] + pal[1][k]) / 2);
+            pal[3][k] = 0;
+        }
+    }
+    pal[2][3] = 255;
+    pal[3][3] = (!bc1 || c0 > c1) ? 255 : 0;
+}
+static void vk_bc_decode_block(int kind, const u8* b, u8* out, size_t pitch)
+{
+    u8 alpha[16];
+    const u8* color = b;
+    if (kind == 2) {                      /* BC2: explicit 4-bit alpha */
+        for (int i = 0; i < 16; i++) { const u8 n = (b[i / 2] >> ((i & 1) * 4)) & 15; alpha[i] = (u8)(n * 17); }
+        color = b + 8;
+    } else if (kind == 3) {               /* BC3: interpolated alpha */
+        u8 a[8] = { b[0], b[1] };
+        if (a[0] > a[1]) for (int i = 1; i < 7; i++) a[i + 1] = (u8)(((7 - i) * a[0] + i * a[1]) / 7);
+        else { for (int i = 1; i < 5; i++) a[i + 1] = (u8)(((5 - i) * a[0] + i * a[1]) / 5); a[6] = 0; a[7] = 255; }
