+/* Some hosts (iOS) offer one output device, already held by cellAudio. Voice then rides in the game mix:
+ * cellAudio calls this per output block and it adds 16 kHz voice upsampled to 48 kHz stereo. */
+static volatile int s_play_mixed;
+void cellVoice_mix_output(float* out, int frames)
+{
+    if (!s_play_mixed) return;
+    static int16_t buf[BLOCK_SAMPLES];
+    static int have, pos, phase;
+    static float prev, cur;
+    for (int i = 0; i < frames; i++) {
+        if (phase == 0) {
+            if (pos >= have) { play_callback(NULL, (Uint8*)buf, (int)sizeof buf); have = BLOCK_SAMPLES; pos = 0; }
+            prev = cur; cur = buf[pos++] / 32768.0f;
+        }
+        const float v = prev + (cur - prev) * (float)phase / 3.0f;
+        out[2 * i] += v; out[2 * i + 1] += v;
+        phase = (phase + 1) % 3;
+    }
+}
