diff --git a/libs/video/rsx_overlay_layout.h b/libs/video/rsx_overlay_layout.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_overlay_layout.h
@@ -0,0 +1,43 @@
+#ifndef RSX_OVERLAY_LAYOUT_H
+#define RSX_OVERLAY_LAYOUT_H
+#include <stdint.h>
+#include <math.h>
+
+typedef struct rsx_overlay_rect { int32_t x, y; uint32_t w, h; } rsx_overlay_rect;
+
+/* area is left/top/right/bottom in normalized window coordinates. */
+static inline rsx_overlay_rect rsx_overlay_safe_rect(uint32_t w, uint32_t h, const float area[6]) {
+    int32_t l = (int32_t)ceilf(w * area[0]), t = (int32_t)ceilf(h * area[1]);
+    int32_t r = (int32_t)floorf(w * area[2]), b = (int32_t)floorf(h * area[3]);
+    if (l < 0) l = 0;
+    if (t < 0) t = 0;
+    if (r > (int32_t)w) r = (int32_t)w;
+    if (b > (int32_t)h) b = (int32_t)h;
+    if (r <= l || b <= t) return (rsx_overlay_rect){0, 0, w, h};
+    return (rsx_overlay_rect){l, t, (uint32_t)(r-l), (uint32_t)(b-t)};
+}
+
+/* A bitmap pixel becomes a UIKit point, bounded by the available safe area.
+ * The menu's 14-pixel glyphs therefore read as 14 points on Retina displays. */
+static inline void rsx_overlay_fit(uint32_t w, uint32_t h, rsx_overlay_rect safe,
+                                  uint32_t screen_h, float point_h, uint32_t* out_w, uint32_t* out_h) {
+    float scale = point_h > 0 ? screen_h / point_h : 1;
+    if (scale * w > safe.w) scale = (float)safe.w / w;
+    if (scale * h > safe.h) scale = (float)safe.h / h;
+    if (scale * w > 2048) scale = 2048.f / w;
+    if (scale * h > 1536) scale = 1536.f / h;
+    *out_w = (uint32_t)floorf(w * scale);
+    *out_h = (uint32_t)floorf(h * scale);
+    if (!*out_w) *out_w = 1;
+    if (!*out_h) *out_h = 1;
+}
+
+/* All mobile panels are horizontally centred; 0 top, 1 bottom, 2 middle. */
+static inline void rsx_overlay_origin(rsx_overlay_rect safe, uint32_t w, uint32_t h,
+                                     int anchor, int32_t* x, int32_t* y) {
+    *x = safe.x + ((int32_t)safe.w - (int32_t)w) / 2;
+    *y = safe.y;
+    if (anchor == 1) *y += (int32_t)safe.h - (int32_t)h;
+    if (anchor == 2) *y += ((int32_t)safe.h - (int32_t)h) / 2;
+}
+#endif
