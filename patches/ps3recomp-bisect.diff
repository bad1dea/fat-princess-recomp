+/* RSX_BISECT (diagnostic, default 0): 1 copy pooled geometry into the slot
+ * buffers, 2 one sampler for every unit, 4 wait for the GPU after each draw,
+ * 8 dummy texture on every unit, 16 magenta instead of 2D lookups (decompiler). */
+static int vk_bisect(void)
+{
+    static int v=-1;
+    if(v<0) {const char* e=getenv("RSX_BISECT");v=e?atoi(e):0;if(v) VK_LOG("RSX_BISECT=%d\n",v);}
+    return v;
+}
+
+/* RSX_BISECT bit 8: every 2D unit samples the dummy texture. RSX_BISECT_TEX=N: only units 0..N-1 keep their texture. */
+static int vk_bisect_dummy(u32 unit)
+{
+    static int n=-1;
+    if(n<0){const char* e=getenv("RSX_BISECT_TEX");n=e?atoi(e):0;}
+    if(vk_bisect()&8) return 1;
+    return n>0 && unit>=(u32)n;
+}
