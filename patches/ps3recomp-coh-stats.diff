                 win, busy, 100.0 * busy / win, s_gpu_submits, s_gpu_lat_n ? s_gpu_lat_sum / s_gpu_lat_n : 0.0, s_gpu_lat_max,
                 s_ts_n, s_ts_sum, 100.0 * s_ts_sum / win, s_ts_n ? s_ts_sum / s_ts_n : 0.0, s_ts_max, s_ts_over25, s_ts_over100);
         s_ts_sum = s_ts_max = 0; s_ts_n = s_ts_over25 = s_ts_over100 = 0;
+#if !defined(_MSC_VER)
+        { extern void spu_coh_stats_print(void) __attribute__((weak)); if (spu_coh_stats_print) spu_coh_stats_print(); }
+#endif
         s_gpu_busy_ms = 0; s_gpu_lat_sum = s_gpu_lat_max = 0; s_gpu_lat_n = 0; s_gpu_submits = 0; s_gpu_win_start = now;
     }
