+/* How the frames really reached the screen (VK_GOOGLE_display_timing, where the driver has it): the gap between consecutive
+ * presents in display refreshes, 1, 2, 3 or more. A game at 30 FPS on a 60 Hz screen should be a steady 2; 3s are judder.
+ * FP_PRESENT_CADENCE=0 turns it off. */
+static PFN_vkGetPastPresentationTimingGOOGLE pvkGetPastPresentationTimingGOOGLE;
+static PFN_vkGetRefreshCycleDurationGOOGLE pvkGetRefreshCycleDurationGOOGLE;
+static int s_dt_on, s_dt_checked;
+static uint32_t s_dt_id;
+static double s_dt_refresh_ns;
+static uint64_t s_dt_last_actual;
+static unsigned s_dt_hist[5];       /* gaps of 1, 2, 3, 4, 5+ refreshes */
+static double s_dt_margin_sum, s_dt_gap_sq, s_dt_gap_sum;
+static unsigned s_dt_n;
+static uint64_t s_dt_win_start;
+static void vk_dt_poll(void)
+{
+    if (!s_dt_on || !s_vk.swapchain) return;
+    VkPastPresentationTimingGOOGLE t[32];
+    u32 n = 32;
+    if (pvkGetPastPresentationTimingGOOGLE(s_vk.device, s_vk.swapchain, &n, t) < 0) return;
+    for (u32 i = 0; i < n; i++) {
+        if (s_dt_last_actual && t[i].actualPresentTime > s_dt_last_actual && s_dt_refresh_ns > 0.0) {
+            const double gap_ns = (double)(t[i].actualPresentTime - s_dt_last_actual);
+            const int cycles = (int)(gap_ns / s_dt_refresh_ns + 0.5);
+            s_dt_hist[cycles < 1 ? 0 : cycles > 5 ? 4 : cycles - 1]++;
+            const double ms = gap_ns / 1.0e6;
+            s_dt_gap_sum += ms; s_dt_gap_sq += ms * ms; s_dt_n++;
+            s_dt_margin_sum += (double)t[i].presentMargin / 1.0e6;
+        }
+        if (t[i].actualPresentTime) s_dt_last_actual = t[i].actualPresentTime;
+    }
+    const uint64_t now = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+    if (!s_dt_win_start) s_dt_win_start = now;
+    if ((double)(now - s_dt_win_start) / (double)f >= 5.0 && s_dt_n) {
+        const double mean = s_dt_gap_sum / s_dt_n, var = s_dt_gap_sq / s_dt_n - mean * mean;
+        fprintf(stderr, "[present-cadence] frames=%u refresh_ms=%.2f gaps(1,2,3,4,5+ refreshes)=%u,%u,%u,%u,%u gap_mean_ms=%.2f gap_sd_ms=%.2f margin_avg_ms=%.2f\n",
+                s_dt_n, s_dt_refresh_ns / 1.0e6, s_dt_hist[0], s_dt_hist[1], s_dt_hist[2], s_dt_hist[3], s_dt_hist[4],
+                mean, var > 0 ? sqrt(var) : 0.0, s_dt_margin_sum / s_dt_n);
+        memset(s_dt_hist, 0, sizeof s_dt_hist); s_dt_gap_sum = s_dt_gap_sq = s_dt_margin_sum = 0; s_dt_n = 0; s_dt_win_start = now;
+    }
+}
+static void vk_dt_init(void)
+{
+    const char* e = getenv("FP_PRESENT_CADENCE");
+    if (e && e[0] == '0') return;
+    if (!s_vk.windowed || !s_vk.swapchain) return;
+    pvkGetPastPresentationTimingGOOGLE = (PFN_vkGetPastPresentationTimingGOOGLE)pvkGetDeviceProcAddr(s_vk.device, "vkGetPastPresentationTimingGOOGLE");
+    pvkGetRefreshCycleDurationGOOGLE = (PFN_vkGetRefreshCycleDurationGOOGLE)pvkGetDeviceProcAddr(s_vk.device, "vkGetRefreshCycleDurationGOOGLE");
+    if (!pvkGetPastPresentationTimingGOOGLE || !pvkGetRefreshCycleDurationGOOGLE) return;
+    VkRefreshCycleDurationGOOGLE rc;
+    if (pvkGetRefreshCycleDurationGOOGLE(s_vk.device, s_vk.swapchain, &rc) != VK_SUCCESS || !rc.refreshDuration) return;
+    s_dt_refresh_ns = (double)rc.refreshDuration;
+    s_dt_on = 1;
+    VK_LOG("present cadence on (refresh %.3f ms)\n", s_dt_refresh_ns / 1.0e6);
+}
