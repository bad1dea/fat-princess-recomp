 /* RSX_BISECT (diagnostic, default 0): 1 copy pooled geometry into the slot
  * buffers, 2 one sampler for every unit, 4 wait for the GPU after each draw,
  * 8 dummy texture on every unit, 16 magenta instead of 2D lookups (decompiler),
- * 32 no border wrap, 64 no LOD range, 128 nearest mip filter (sampler creation). */
+ * 256 barrier the sampled render targets and all memory before each pass; 32 no border wrap, 64 no LOD range, 128 nearest mip filter (sampler creation). */
 static int vk_bisect(void)
 {
     static int v=-1;
@@ -4931,6 +4931,19 @@
      * snapshot, flush, destruction or framebuffer change ends the pass. */
     if(!keep_pass || !s_batch_renderpass || s_batch_framebuffer!=fb) {
