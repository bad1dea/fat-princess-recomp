+/* Wide lines on devices without the wideLines feature (Metal): the game draws priest beams as line strips with a requested
+ * pixel width. The vertex program is wrapped so one draw is repeated as instances, each shifted by a whole-pixel offset inside
+ * a disc of the requested diameter, and the output colour is scaled so the overlapping copies add up to the original
+ * brightness. Returns the number of instances, or 0 when the wide path is not available for this draw. */
+#define VK_WIDE_MAX_INST 320u
+static u32 vk_eng_wide_line(vk_eng_pipe* P, u32 topo_idx, float width_px, float vpw, float vph, VkPipeline* out_pipe)
+{
+    if (!P->vs_hlsl || width_px < 1.5f || vpw < 1.0f || vph < 1.0f) return 0;
+    if (width_px > 16.0f) width_px = 16.0f;
+    width_px = floorf(width_px + 0.5f);   /* whole pixels: few variants, none ever replaced */
+    if (width_px < 2.0f) return 0;
+    const float R = width_px * 0.575f;   /* a little wider than asked: the copies thin out toward the edge */
+    int ox[VK_WIDE_MAX_INST], oy[VK_WIDE_MAX_INST];
+    u32 n = 0;
+    const int ir = (int)(R + 0.5f);
+    for (int j = -ir; j <= ir; j++)
+        for (int i = -ir; i <= ir; i++)
+            if ((float)(i * i + j * j) <= R * R + 0.25f && n < VK_WIDE_MAX_INST) { ox[n] = i; oy[n] = j; n++; }
+    if (n < 2) return 0;
+    const u32 key = ((u32)(width_px * 4.0f) << 20) ^ ((u32)vpw << 10) ^ (u32)vph ^ 0x80000000u;
+    u32 slot = VK_WIDE_SLOTS;
+    for (u32 w = 0; w < VK_WIDE_SLOTS; w++) if (P->wide[w].key == key) slot = w;
+    if (slot < VK_WIDE_SLOTS && !P->wide[slot].vs) return 0;   /* translation failed before: stay a thin line */
+    if (slot == VK_WIDE_SLOTS) {
+        const char* head = strstr(P->vs_hlsl, "VSOutput main(VSInput input)");
+        if (!head) return 0;
+        for (u32 w = 0; w < VK_WIDE_SLOTS; w++) if (!P->wide[w].vs && !P->wide[w].key) { slot = w; break; }
+        if (slot == VK_WIDE_SLOTS) return 0;   /* all taken: this draw stays a thin line */
+        const size_t head_len = (size_t)(head - P->vs_hlsl);
+        const size_t cap = strlen(P->vs_hlsl) + 64u * VK_WIDE_MAX_INST + 1024u;
+        char* text = (char*)malloc(cap);
+        if (!text) return 0;
+        size_t used = 0;
+        memcpy(text, P->vs_hlsl, head_len); used = head_len;
+        used += (size_t)snprintf(text + used, cap - used, "VSOutput vs_core(VSInput input)");
+        const char* rest = head + strlen("VSOutput main(VSInput input)");
+        const size_t rest_len = strlen(rest);
+        memcpy(text + used, rest, rest_len); used += rest_len;
+        used += (size_t)snprintf(text + used, cap - used, "\nstatic const float2 wl_off[%u] = {", n);
+        for (u32 k = 0; k < n; k++)
+            used += (size_t)snprintf(text + used, cap - used, "%sfloat2(%d.0,%d.0)", k ? "," : "", ox[k], oy[k]);
+        /* A pixel inside the band is covered by about the band's width in copies: scale by the inverse. */
+        /* The middle of the band is covered by 2*ir+1 copies; scaling by their count keeps the middle at the colour the game asked for
+         * (no channel clips, so the hue stays) while the edges fade. */
+        const float scale = 1.0f / (float)(2 * ir + 1);
+        used += (size_t)snprintf(text + used, cap - used,
+            "};\nVSOutput main(VSInput input, uint wl_iid : SV_InstanceID) {\n"
+            "    VSOutput o = vs_core(input);\n"
+            "    o.pos.xy += wl_off[wl_iid] * float2(%.9f, %.9f) * o.pos.w;\n"
+            "    o.col0 *= %.9f; o.col1 *= %.9f;\n"
+            "    return o;\n}\n", 2.0f / vpw, 2.0f / vph, scale, scale);
+        const int bad = vk_eng_translate(text, RSX_SHADER_STAGE_VERTEX, &P->wide[slot].vs);
+        free(text);
+        if (bad) { P->wide[slot].vs = VK_NULL_HANDLE; P->wide[slot].key = key; return 0; }
+        P->wide[slot].key = key;
+        { static int logged = 0; if (logged++ < 4) VK_LOG("wide lines: %.1f px as %u instances (viewport %.0fx%.0f)\n", width_px, n, vpw, vph); }
+    }
+    *out_pipe = vk_eng_variant_ex(P, topo_idx, P->wide[slot].vs, &P->wide[slot].pipe[topo_idx]);
+    return *out_pipe ? n : 0;
 }
 
