+/* RSX_BISECT 16384: give every 2D fragment program one binding per texture unit (the cube-map layout) instead of the
+ * rsx_tex[16] array, to test MoltenVK's array handling with argument buffers off. Returns a heap copy or NULL. */
+static char* vk_bisect_split_ps(const char* ps)
+{
+    static const char decl[] = "Texture2D    rsx_tex[16] : register(t0);\n";
+    const char* d = strstr(ps, decl);
+    if (!d) return NULL;
+    char* out = malloc(strlen(ps) + 2048);
+    if (!out) return NULL;
+    char* o = out;
+    memcpy(o, ps, (size_t)(d - ps)); o += d - ps;
+    for (u32 u = 0; u < 16; u++) o += sprintf(o, "Texture2D   rsx_tex%u : register(t%u);\n", u, u);
+    const char* r = d + sizeof decl - 1;
+    while (*r) {
+        if (!strncmp(r, "rsx_tex[", 8)) {
+            const char* q = r + 8; unsigned n = 0, digits = 0;
+            while (*q >= '0' && *q <= '9') { n = n * 10 + (unsigned)(*q - '0'); q++; digits++; }
+            if (digits && *q == ']') { o += sprintf(o, "rsx_tex%u", n); r = q + 1; continue; }
+        }
+        *o++ = *r++;
+    }
+    *o = 0;
+    return out;
+}
