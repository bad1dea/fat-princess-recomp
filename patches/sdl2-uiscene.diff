+UIWindowScene *UIKit_GetActiveWindowScene(void)
+{
+    UIWindowScene *inactive = nil, *any = nil;
+    for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+        if (scene.activationState == UISceneActivationStateForegroundActive) {
+            return (UIWindowScene *)scene;
+        }
+        if (scene.activationState == UISceneActivationStateForegroundInactive && !inactive) {
+            inactive = (UIWindowScene *)scene;
+        }
+        if (!any) {
+            any = (UIWindowScene *)scene;
+        }
+    }
+    return inactive ? inactive : any;
+}
+
+#if !TARGET_OS_TV
+/* statusBarOrientation returns Unknown on iOS 27; the scene geometry has it. */
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 270000
+    if (@available(iOS 27.0, *)) {
+        UIWindowScene *scene = UIKit_GetActiveWindowScene();
+        return scene ? scene.effectiveGeometry.interfaceOrientation : UIInterfaceOrientationUnknown;
+    }
+#endif
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    return [UIApplication sharedApplication].statusBarOrientation;
+#pragma clang diagnostic pop
+}
+#endif
